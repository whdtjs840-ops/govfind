---
import "../styles/global.css";
import { Grid2X2, Home, List, Search } from "@lucide/astro";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
};

const {
  title = "GovFind - 정부지원금 맞춤 검색",
  description = "공식 출처 기준으로 정리된 정부지원금 검색 서비스입니다. 자격을 단정하지 않고 조건 확인과 공식 신청처 이동을 돕습니다.",
  canonical = Astro.url.pathname
} = Astro.props;

const siteUrl = "https://govfind.kr";
const canonicalUrl = new URL(canonical, siteUrl).toString();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GovFind" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="google-adsense-account" content="ca-pub-9193282929753279" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9193282929753279" crossorigin="anonymous"></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "GovFind",
      url: siteUrl,
      description: "공식 출처 기준으로 정리된 정부지원금 검색 서비스",
      potentialAction: {
        "@type": "SearchAction",
        target: `${siteUrl}/support/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
  </head>
  <body>
    <a class="skip-link" href="#content">본문 바로가기</a>
    <header class="site-header">
      <nav class="nav wrap" aria-label="주요 메뉴">
        <a class="brand header-logo" href="/" aria-label="GovFind 홈">
          <span class="brand-mark">G</span>
          <span class="brand-copy">
            <span class="brand-title">GovFind</span>
            <span class="brand-sub">정부지원금 맞춤 검색</span>
          </span>
        </a>
        <div class="nav-links">
          <a href="/">홈</a>
          <a href="/support/">탐색</a>
          <a href="/deadline/">마감임박</a>
          <a href="/guide/">가이드</a>
          <a href="/support/?q=">검색</a>
        </div>
        <a class="nav-cta icon-only" href="/support/" aria-label="검색">
          <Search size={20} aria-hidden="true" />
        </a>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <a class="brand footer-brand" href="/">
            <span class="brand-mark">G</span>
            <span>GovFind</span>
          </a>
          <p>공식 출처 기준으로 정부지원금을 정리하고, 자격을 단정하지 않은 상태에서 조건 확인과 공식 신청처 이동을 돕습니다.</p>
        </div>
        <div>
          <h2>서비스</h2>
          <a href="/support/">전체 목록</a>
          <a href="/support/">검색</a>
          <a href="/category/youth/">청년</a>
          <a href="/category/welfare/">복지</a>
          <a href="/category/job/">고용</a>
        </div>
        <div>
          <h2>운영 정보</h2>
          <a href="/about/">소개</a>
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/terms/">이용약관</a>
          <a href="/contact/">문의하기</a>
        </div>
      </div>
      <div class="wrap footer-disclaimer">
        본 서비스의 정보는 공공데이터를 기반으로 제공되며, 정확한 내용은 해당 기관에 확인하시기 바랍니다.
      </div>
    </footer>
    <nav class="mobile-tabbar" aria-label="모바일 빠른 메뉴">
      <a href="/">
        <Home size={19} aria-hidden="true" />
        <span>홈</span>
      </a>
      <a href="/support/">
        <List size={19} aria-hidden="true" />
        <span>목록</span>
      </a>
      <a href="/support/">
        <Search size={19} aria-hidden="true" />
        <span>검색</span>
      </a>
      <a href="/support/?category=창업">
        <Grid2X2 size={19} aria-hidden="true" />
        <span>카테고리</span>
      </a>
    </nav>
    <script is:inline>
      window.govfindEvents = window.govfindEvents || [];
      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target.closest("[data-event]") : null;
        if (!target) return;
        const payload = {
          event: target.getAttribute("data-event"),
          policy: target.getAttribute("data-policy"),
          path: window.location.pathname,
          at: new Date().toISOString()
        };
        window.govfindEvents.push(payload);
        document.documentElement.dataset.lastEvent = payload.event || "";
        try {
          window.localStorage.setItem("govfind:lastEvent", JSON.stringify(payload));
        } catch {
          // Keep navigation available even when local storage is blocked.
        }
        window.dispatchEvent(new CustomEvent("govfind:event", { detail: payload }));
      });
    </script>
  </body>
</html>
