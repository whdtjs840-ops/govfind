---
import { Bell, Bookmark, ExternalLink } from "@lucide/astro";
import type { Policy } from "../data/policies";

const { policy, compact = false } = Astro.props as { policy: Policy; compact?: boolean };
const searchText = [
  policy.title,
  policy.category,
  policy.source,
  policy.agency,
  policy.region,
  policy.lifeStage,
  policy.targetGroup,
  policy.summary,
  ...policy.tags
].join(" ");
const matchScore = Math.min(96, 72 + policy.matchReasons.length * 4 + (policy.applyOnline ? 8 : 0) + (policy.status === "마감임박" ? 5 : 0));
---

<article
  class="card policy-card support-card"
  data-category={policy.category}
  data-region={policy.region}
  data-status={policy.status}
  data-source={policy.source}
  data-online={String(policy.applyOnline)}
  data-score={String(matchScore)}
  data-dday={policy.dday}
  data-views={String(policy.views)}
  data-search={searchText}
>
  <div class="meta">
    <span class="badge">{policy.category}</span>
    <span class={policy.status === "마감임박" ? "badge deadline" : "badge warn"}>{policy.status}</span>
    <span class="badge soft">{policy.source}</span>
  </div>
  <div>
    <h3><a href={`/support/${policy.slug}/`}>{policy.title}</a></h3>
    <p>{policy.summary}</p>
  </div>
  <dl class="card-facts">
    <div><dt>예상 적합도</dt><dd>{matchScore}%</dd></div>
    <div><dt>기관</dt><dd>{policy.agency}</dd></div>
    <div><dt>지역</dt><dd>{policy.region}</dd></div>
    <div><dt>지원</dt><dd>{policy.amount}</dd></div>
    <div><dt>마감</dt><dd>{policy.dday}</dd></div>
    <div><dt>관심</dt><dd>{policy.views.toLocaleString("ko-KR")}</dd></div>
    <div><dt>수정</dt><dd>{policy.updatedAt}</dd></div>
  </dl>
  {!compact && (
    <ul class="reason-list" aria-label="적합 이유">
      {policy.matchReasons.slice(0, 2).map((reason) => <li>{reason}</li>)}
    </ul>
  )}
  <div class="card-actions">
    <a class="button secondary" href={`/support/${policy.slug}/`} data-event="policy_click" data-policy={policy.slug}>상세 비교</a>
    <button class="icon-action" type="button" data-action="save" data-event="save_policy" data-policy={policy.slug}><Bookmark size={16} />저장</button>
    <button class="icon-action" type="button" data-action="alert" data-event="subscribe_alert" data-policy={policy.slug}><Bell size={16} />알림</button>
    <a class="text-link" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug}><ExternalLink size={15} />공식 신청처</a>
  </div>
</article>
