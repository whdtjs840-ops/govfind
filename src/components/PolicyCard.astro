---
import { ArrowRight, ExternalLink } from "@lucide/astro";
import type { Policy } from "../data/policies";
import { sourceLabel } from "../utils/sourceNames";
import {
  cleanSummary,
  deadlineDisplay,
  getDisplayRegion,
  getDisplayStatus,
  isDeadlineSoonPolicy,
  isSearchOnlyPolicy,
  policySearchText,
  shouldIncludeInDeadlineSort,
  shouldIncludeInRegionPage,
  shouldIncludeInStatusFilter,
  shouldRequireOfficialConfirmation,
  shouldShowDday
} from "../utils/policyUtils";

const { policy, compact = false } = Astro.props as { policy: Policy; compact?: boolean };
const publicSourceLabel = sourceLabel(policy.source);
const searchText = policySearchText({ ...policy, source: publicSourceLabel });
const summary = cleanSummary(policy.summary);
const amount = cleanSummary(policy.amount);
const target = cleanSummary(policy.targetGroup || policy.audience);
const matchScore = Math.min(96, 72 + policy.matchReasons.length * 4 + (policy.applyOnline ? 8 : 0) + (isDeadlineSoonPolicy(policy) ? 5 : 0));
const searchOnly = isSearchOnlyPolicy(policy);
const deadlineLabel = deadlineDisplay(policy);
const displayStatus = getDisplayStatus(policy);
const displayRegion = getDisplayRegion(policy);
const showOfficialConfirmation = shouldRequireOfficialConfirmation(policy);
const cardStatusLabel = showOfficialConfirmation || displayStatus === "공식 공고 확인" ? "공식확인" : displayStatus;
const visibleTags = policy.tags
  .filter((value) => value && !["null", "undefined"].includes(String(value).toLowerCase()))
  .slice(0, 3);
---

<article
  class="card policy-card support-card"
  data-category={policy.category}
  data-region={policy.region ?? ""}
  data-region-label={displayRegion}
  data-include-region-page={String(shouldIncludeInRegionPage(policy))}
  data-status={policy.status}
  data-status-label={displayStatus}
  data-status-confidence={policy.statusConfidence ?? "known"}
  data-include-status-filters={String(shouldIncludeInStatusFilter(policy, policy.status))}
  data-source={publicSourceLabel}
  data-source-label={publicSourceLabel}
  data-online={String(policy.applyOnline)}
  data-score={String(matchScore)}
  data-dday={shouldShowDday(policy) ? policy.dday : ""}
  data-include-deadline-sort={String(shouldIncludeInDeadlineSort(policy))}
  data-show-dday={String(shouldShowDday(policy))}
  data-updated={policy.updatedAt}
  data-views={String(policy.views)}
  data-search-only={String(searchOnly)}
  data-title={policy.title}
  data-tags={policy.tags.filter((value) => value && !["null", "undefined"].includes(String(value).toLowerCase())).join(" ")}
  data-purpose={[policy.category, policy.amount, ...policy.benefits].filter((value) => value && !["null", "undefined"].includes(String(value).toLowerCase())).join(" ")}
  data-documents={policy.documents.filter((value) => value && !["null", "undefined"].includes(String(value).toLowerCase())).join(" ")}
  data-search={searchText}
  hidden={searchOnly}
>
  <div class="meta policy-card-topline">
    <span class={isDeadlineSoonPolicy(policy) ? "badge deadline" : "badge warn"}>{cardStatusLabel}</span>
    <span class="badge">{policy.category}</span>
    <span class="badge soft">{publicSourceLabel}</span>
  </div>
  <div class="policy-card-main">
    <h3><a href={`/support/${policy.slug}/`}>{policy.title}</a></h3>
    <p class="policy-card-summary">{summary}</p>
    {visibleTags.length > 0 && (
      <div class="policy-tag-row" aria-label="관련 태그">
        {visibleTags.map((tag) => <span class="policy-tag-pill">{tag}</span>)}
      </div>
    )}
    <p class="policy-quick-line">
      <strong>대상</strong> {target || "공식 확인 필요"}
      <span>·</span>
      <strong>지역</strong> {displayRegion}
    </p>
  </div>
  <dl class="card-facts">
    <div><dt>신청</dt><dd>{policy.applyOnline ? "온라인 가능" : "기관 확인"}</dd></div>
    <div><dt>마감</dt><dd>{deadlineLabel}</dd></div>
    <div><dt>기관</dt><dd>{policy.agency}</dd></div>
    <div><dt>지원</dt><dd>{amount || "공식 확인 필요"}</dd></div>
  </dl>
  <div class="card-actions">
    <a class="button official-link" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug}><ExternalLink size={15} />신청처 바로가기</a>
    <a class="button secondary" href={`/support/${policy.slug}/`} data-event="policy_click" data-policy={policy.slug}>자세히 보기 <ArrowRight size={15} /></a>
    <span class="card-action-note">신청은 공식 기관 페이지에서 진행됩니다</span>
  </div>
</article>
