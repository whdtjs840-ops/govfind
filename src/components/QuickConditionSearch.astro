---
const conditionGroups = [
  {
    key: "profile",
    label: "유형",
    options: ["개인", "가구", "사업자"]
  },
  {
    key: "age",
    label: "연령대",
    options: ["청년", "중장년", "어르신", "아동·청소년", "전체"]
  },
  {
    key: "region",
    label: "지역",
    options: ["전국", "서울", "경기", "인천", "부산", "대구", "광주", "대전", "지역별"]
  },
  {
    key: "lifeStage",
    label: "생애주기",
    options: ["구직", "취업", "창업", "주거", "육아", "복지", "농어업"]
  },
  {
    key: "status",
    label: "상태",
    options: ["온라인 가능", "마감임박", "상시신청", "최근 업데이트"]
  }
];

const { standalone = false } = Astro.props as { standalone?: boolean };
---

<section class="quick-condition-search" id="condition-search" aria-label="익명 조건 검색">
  <div class="quick-condition-head">
    <div>
      <p class="eyebrow">익명 퀵파인더</p>
      <h2>로그인 없이 조건을 골라 지원금을 좁혀보세요</h2>
      <p>받을 수 있다고 단정하지 않고, 신청 전에 확인할 정책과 공식 신청처를 빠르게 찾습니다.</p>
    </div>
    <a class="text-link" href="/support/">선택 초기화</a>
  </div>

  <div class="condition-step-grid">
    {conditionGroups.map((group, index) => (
      <div class="condition-row" data-condition-group={group.key}>
        <strong><span>{index + 1}</span>{group.label}</strong>
        <div>
          {group.options.map((option) => (
            <button type="button" class="condition-chip" data-condition-key={group.key} data-condition-value={option}>{option}</button>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="condition-footer">
    <p>선택값은 저장하지 않습니다. 결과 페이지에서 카테고리, 지역, 출처, 온라인 신청 여부를 다시 조정할 수 있습니다.</p>
    <button type="button" class="button condition-submit" id="conditionSubmit">조건에 맞는 지원금 보기</button>
  </div>
</section>

{standalone && (
  <script>
    const conditionChips = Array.from(document.querySelectorAll<HTMLButtonElement>("#condition-search .condition-chip"));
    const conditionSubmit = document.querySelector<HTMLButtonElement>("#conditionSubmit");

    conditionChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const group = chip.closest("[data-condition-group]");
        const wasActive = chip.classList.contains("active");
        group?.querySelectorAll(".condition-chip").forEach((item) => item.classList.remove("active"));
        if (!wasActive) chip.classList.add("active");
      });
    });

    conditionSubmit?.addEventListener("click", () => {
      const next = new URLSearchParams();

      for (const chip of conditionChips.filter((item) => item.classList.contains("active"))) {
        const key = chip.dataset.conditionKey;
        const value = chip.dataset.conditionValue ?? "";
        if (!key || !value) continue;

        if (key === "status" && value === "온라인 가능") next.set("applyOnline", "true");
        else if (key === "status" && value === "마감임박") next.set("status", "마감임박");
        else if (key === "status" && value === "상시신청") next.set("status", "상시");
        else if (key === "status" && value === "최근 업데이트") next.set("sort", "updated");
        else if (key === "age") next.set("target", value);
        else if (key === "lifeStage") next.set("purpose", value);
        else if (key === "profile") next.set("profile", value);
        else next.set(key, value);
      }

      window.location.href = `/support/${next.toString() ? `?${next.toString()}` : ""}`;
    });
  </script>
)}
