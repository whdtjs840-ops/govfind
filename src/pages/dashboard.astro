---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CheckCircle2, FileArchive, ListChecks, MapPin, Search } from "@lucide/astro";
import { policies } from "../data/policies";

const urgentPolicies = policies.filter((policy) => policy.status === "마감임박" || policy.status === "모집중").slice(0, 3);
const recentPolicies = policies.slice(3, 6);
---

<BaseLayout title="지원금 확인 체크리스트 - GovFind" description="정부지원금 신청 전 대상 조건, 마감일, 필요 서류, 공식 원문을 확인하는 비로그인 체크리스트입니다." canonical="/dashboard/">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">신청 전 체크리스트</p>
      <h1>공식 신청 전 확인해야 할 항목을 정리했습니다</h1>
      <p class="lead">회원가입 없이 정책을 탐색한 뒤, 대상 조건·마감일·필요 서류·공식 원문을 확인하고 기관 페이지로 이동하는 흐름입니다.</p>
      <div class="toolbar">
        <a class="button" href="/support/"><Search size={18} />새 지원금 찾기</a>
        <a class="button secondary" href="/deadline/">마감임박 보기</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap dashboard-grid">
      <section class="dashboard-summary" aria-label="체크리스트 요약">
        <div>
          <strong>{policies.length}</strong>
          <span>현재 비교 가능한 정책</span>
        </div>
        <div>
          <strong>4</strong>
          <span>신청 전 핵심 확인</span>
        </div>
        <div>
          <strong>{urgentPolicies.length}</strong>
          <span>마감·모집 추적</span>
        </div>
        <div>
          <strong>공식</strong>
          <span>기관 신청 원칙</span>
        </div>
      </section>

      <section class="card dashboard-panel">
        <h2><MapPin size={20} />조건 확인 기준</h2>
        <p class="notice">나이, 지역, 가구상황, 소득 기준은 정책마다 다릅니다. GovFind의 요약은 탐색용이며 최종 기준은 공식 공고를 확인해야 합니다.</p>
        <div class="match-stack">
          <span>생애주기</span>
          <span>지역</span>
          <span>소득·가구</span>
          <span>온라인 신청</span>
        </div>
      </section>

      <section class="card dashboard-panel">
        <h2><CheckCircle2 size={20} />마감·모집 확인</h2>
        <div class="dashboard-list">
          {urgentPolicies.map((policy) => (
            <a href={`/support/${policy.slug}/`}>
              <strong>{policy.title}</strong>
              <span>{policy.agency} · {policy.dday}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="card dashboard-panel">
        <h2>최근 본 정책</h2>
        <div class="dashboard-list">
          {recentPolicies.map((policy) => (
            <a href={`/support/${policy.slug}/`}>
              <strong>{policy.title}</strong>
              <span>{policy.source} · {policy.updatedAt}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="card dashboard-panel">
        <h2><ListChecks size={20} />공식 신청 전 순서</h2>
        <div class="progress-steps dashboard-progress" aria-label="공식 신청 전 확인 순서">
          <span class="active">대상 확인</span>
          <span class="active">서류 확인</span>
          <span>마감 확인</span>
          <span>원문 확인</span>
          <span>기관 제출</span>
        </div>
      </section>

      <section class="card dashboard-panel">
        <h2>확인해야 할 원문 정보</h2>
        <div class="setting-list">
          <div><strong>신청 기간</strong><span>공고 기준</span></div>
          <div><strong>지원 대상</strong><span>기관 기준</span></div>
          <div><strong>제출 서류</strong><span>정책별 상이</span></div>
          <div><strong>문의처</strong><span>공식 기관</span></div>
        </div>
      </section>

      <section class="card dashboard-panel">
        <h2><FileArchive size={20} />서류 체크</h2>
        <ul class="doc-list">
          <li>신분 확인 서류 <span>준비 필요</span></li>
          <li>소득·가구 자료 <span>정책별 확인</span></li>
          <li>계약서·사업자 서류 <span>해당자만</span></li>
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>
