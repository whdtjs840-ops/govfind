---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ExternalLink } from "@lucide/astro";
import { policies } from "../../data/policies";

export function getStaticPaths() {
  return policies.map((policy) => ({ params: { slug: policy.slug }, props: { policy } }));
}

const { policy } = Astro.props;
const apiDetails = policy.apiDetails;
const detailTarget = apiDetails?.target || policy.audience || policy.targetGroup;
const detailBenefit = apiDetails?.benefit || policy.benefits.join("\n");
const detailApply = apiDetails?.application || policy.apply;
const detailCriteria = apiDetails?.criteria || "";
const relatedPolicies = policies
  .filter((item) => item.slug !== policy.slug && (item.category === policy.category || item.region === policy.region || item.tags.some((tag) => policy.tags.includes(tag))))
  .slice(0, 4);
const reviewSearchUrl = `https://search.naver.com/search.naver?query=${encodeURIComponent(`${policy.title} 후기 신청`)}`;

function lines(value?: string, max = 12) {
  return (value ?? "")
    .split(/\n{2,}|\n|(?<=다\.)\s+|(?<=요\.)\s+/)
    .map((item) => item.trim())
    .filter(Boolean)
    .slice(0, max);
}

const targetLines = lines(detailTarget, 10);
const benefitLines = lines(detailBenefit, 10);
const applyLines = lines(detailApply, 10);
const criteriaLines = lines(detailCriteria, 8);
---

<BaseLayout title={`${policy.title} - 지원 대상과 신청 방법 | GovFind`} description={policy.summary} canonical={`/support/${policy.slug}/`}>
  <section class="policy-doc-head">
    <div class="wrap doc-wrap">
      <nav class="breadcrumb" aria-label="현재 위치">
        <a href="/">홈</a>
        <span>/</span>
        <a href="/support/">정책 목록</a>
        <span>/</span>
        <a href={`/category/${policy.category === "복지" ? "welfare" : policy.category === "주거" ? "housing" : policy.category === "고용" ? "job" : policy.category === "청년" ? "youth" : "startup"}/`}>{policy.category}</a>
      </nav>

      <div class="policy-doc-title">
        <div class="policy-status-row">
          <span class={policy.status === "마감임박" ? "badge deadline" : "badge warn"}>{policy.status}</span>
          <span class="badge">{policy.category}</span>
          <span class="badge soft">{policy.dday}</span>
          <span class="badge soft">{policy.source}</span>
        </div>
        <h1>{policy.title}</h1>
        <p class="doc-meta">등록 {policy.updatedAt} · 수정 {policy.updatedAt} · 조회 {policy.views.toLocaleString("ko-KR")}</p>
        <a class="button doc-primary" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug}>
          <ExternalLink size={18} />바로 신청하기
        </a>
      </div>
    </div>
  </section>

  <section class="section policy-doc-section">
    <div class="wrap doc-wrap">
      <article class="policy-doc">
        <section class="doc-block">
          <h2>핵심 요약</h2>
          <p>
            이 정책은 {policy.targetGroup} 대상자가 {policy.amount} 지원을 검토할 때 확인할 수 있는 {policy.category} 지원 정보입니다.
            {policy.agency}에서 운영하며, 신청 기간은 {policy.deadline}입니다. 최종 자격과 접수 가능 여부는 공식 신청처에서 다시 확인해야 합니다.
          </p>
        </section>

        <section class="doc-block">
          <h3>기본 정보</h3>
          <dl class="doc-info-table">
            <div><dt>분류</dt><dd>{policy.category}</dd></div>
            <div><dt>담당부처</dt><dd>{policy.agency}</dd></div>
            <div><dt>지역</dt><dd>{policy.region}</dd></div>
            <div><dt>신청기간</dt><dd>{policy.deadline} <strong>{policy.dday}</strong></dd></div>
            <div><dt>지원규모</dt><dd>{policy.amount}</dd></div>
            <div><dt>출처</dt><dd>{policy.source}</dd></div>
          </dl>
        </section>

        <section class="doc-block">
          <h3>정책 요약</h3>
          <p>{policy.summary}</p>
        </section>

        <section class="doc-block">
          <h3>지원 대상</h3>
          {targetLines.length ? targetLines.map((item) => <p>{item}</p>) : <p>공식 상세 페이지에서 지원 대상을 확인해야 합니다.</p>}
        </section>

        {criteriaLines.length > 0 && (
          <section class="doc-block">
            <h3>선정 기준</h3>
            {criteriaLines.map((item) => <p>{item}</p>)}
          </section>
        )}

        <section class="doc-block">
          <h3>지원 내용</h3>
          {benefitLines.length ? (
            <ul class="doc-list">
              {benefitLines.map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <p>지원 내용은 공식 공고를 기준으로 확인해야 합니다.</p>
          )}
        </section>

        <section class="doc-block">
          <h3>신청 방법</h3>
          {applyLines.length ? applyLines.map((item) => <p>{item}</p>) : <p>복지로 또는 소관 기관의 공식 신청 안내를 확인합니다.</p>}
          <p class="notice">GovFind는 자격을 단정하지 않습니다. 신청 전 기관명, 제출 서류, 접수 기간을 공식 페이지에서 다시 확인하세요.</p>
        </section>

        <section class="doc-block">
          <h3>필요 서류</h3>
          <ul class="doc-list">
            {policy.documents.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="doc-block">
          <h3>자주 묻는 질문</h3>
          <div class="faq-list doc-faq">
            {policy.faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="doc-block">
          <h3>관련 후기와 참고 검색</h3>
          <p>실제 신청 경험담은 개인 상황에 따라 다를 수 있습니다. 후기성 글은 참고용으로만 보고, 최종 조건은 공식 기관 안내를 기준으로 확인하세요.</p>
          <ul class="related-links">
            <li><a href={reviewSearchUrl} target="_blank" rel="noopener noreferrer">네이버에서 관련 후기 검색</a></li>
            <li><a href={policy.officialSourceUrl} target="_blank" rel="noopener noreferrer">공식 출처 확인</a></li>
          </ul>
        </section>
      </article>

      <aside class="doc-side">
        <div class="card doc-side-card">
          <h2>공식 확인</h2>
          <dl class="summary-dl">
            <div><dt>기관</dt><dd>{policy.agency}</dd></div>
            <div><dt>문의</dt><dd>{policy.contact}</dd></div>
            <div><dt>마감</dt><dd>{policy.deadline}</dd></div>
          </dl>
          <a class="button" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug}>
            <ExternalLink size={18} />공식 신청하기
          </a>
        </div>

        {relatedPolicies.length > 0 && (
          <div class="card doc-side-card">
            <h2>함께 볼 정책</h2>
            <ul class="side-policy-list">
              {relatedPolicies.map((item) => (
                <li>
                  <a href={`/support/${item.slug}/`}>
                    <strong>{item.title}</strong>
                    <span>{item.category} · {item.dday}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  <div class="sticky-detail-cta" aria-label="상세 페이지 빠른 실행">
    <span>{policy.title}</span>
    <a class="button" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug}>
      <ExternalLink size={17} />공식 신청하기
    </a>
    <a class="button secondary" href="/support/">목록으로</a>
  </div>
</BaseLayout>
