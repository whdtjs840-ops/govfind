---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Bell, Bookmark, CheckCircle2, ExternalLink, FileCheck2 } from "@lucide/astro";
import { policies } from "../../data/policies";

export function getStaticPaths() {
  return policies.map((policy) => ({ params: { slug: policy.slug }, props: { policy } }));
}

const { policy } = Astro.props;
const matchScore = Math.min(96, 72 + policy.matchReasons.length * 4 + (policy.applyOnline ? 8 : 0) + (policy.status === "마감임박" ? 5 : 0));
---

<BaseLayout title={`${policy.title} - 자격조건과 공식 신청처 | GovFind`} description={policy.summary} canonical={`/support/${policy.slug}/`}>
  <section class="detail-hero">
    <div class="wrap detail-grid">
      <div>
        <p class="eyebrow">{policy.category}</p>
        <h1>{policy.title}</h1>
        <p class="lead">{policy.summary}</p>
        <div class="toolbar">
          <span class="badge score">예상 적합도 {matchScore}%</span>
          <span class="badge">{policy.source}</span>
          <span class="badge warn">{policy.region}</span>
          <span class="badge deadline">{policy.dday}</span>
        </div>
      </div>
      <aside class="card cta-card">
        <p class="eyebrow">첫 화면 핵심 정보</p>
        <dl class="summary-dl">
          <div><dt>예상 적합도</dt><dd>{matchScore}%</dd></div>
          <div><dt>예상 지원</dt><dd>{policy.amount}</dd></div>
          <div><dt>신청 기간</dt><dd>{policy.deadline}</dd></div>
          <div><dt>대상</dt><dd>{policy.targetGroup}</dd></div>
        </dl>
        <a class="button" href={policy.officialUrl} target="_blank" rel="noopener noreferrer"><ExternalLink size={18} />공식 신청처 이동</a>
        <div class="detail-actions">
          <button class="button secondary" type="button"><Bookmark size={17} />서류 준비 저장</button>
          <button class="button secondary" type="button"><Bell size={17} />마감 알림 받기</button>
        </div>
        <p class="notice">GovFind는 자격을 단정하지 않습니다. 최종 신청과 판정은 공식 기관에서 확인하세요.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <article class="grid">
        <section class="card">
          <h2><CheckCircle2 size={20} />왜 추천되었나요?</h2>
          <ul class="list-clean">
            {policy.matchReasons.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="card">
          <h2>자격 체크</h2>
          <dl class="summary-dl">
            <div><dt>생애주기</dt><dd>{policy.lifeStage}</dd></div>
            <div><dt>소득 기준</dt><dd>{policy.income}</dd></div>
            <div><dt>온라인 신청</dt><dd>{policy.applyOnline ? "가능성 높음" : "공고 확인 필요"}</dd></div>
            <div><dt>대상 설명</dt><dd>{policy.audience}</dd></div>
          </dl>
        </section>
        <section class="card">
          <h2>지원 내용</h2>
          <ul class="list-clean">
            {policy.benefits.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="card">
          <h2><FileCheck2 size={20} />필요 서류</h2>
          <ul class="list-clean">
            {policy.documents.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="card">
          <h2>신청 방법</h2>
          <p>{policy.apply}</p>
          <p class="notice">원문 출처: <a class="text-link" href={policy.officialSourceUrl} target="_blank" rel="noopener noreferrer">{policy.source}</a></p>
        </section>
        <section class="card">
          <h2>신청 진행 트래커</h2>
          <div class="progress-steps" aria-label="신청 진행 단계">
            <span class="active">저장됨</span>
            <span>서류 준비</span>
            <span>신청 완료</span>
            <span>심사 중</span>
            <span>결과 수신</span>
          </div>
        </section>
        <section class="card">
          <h2>FAQ</h2>
          <div class="faq-list">
            {policy.faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      </article>
      <aside class="aside">
        <div class="card">
          <h2>공식 확인</h2>
          <p>신청 전 기관명, 문의처, 마감일, 필요서류를 공식 페이지에서 다시 확인하세요.</p>
          <ul class="list-clean">
            <li>기관: {policy.agency}</li>
            <li>문의: {policy.contact}</li>
            <li>마감: {policy.deadline}</li>
          </ul>
          <div class="toolbar">
            <a class="button" href={policy.officialUrl} target="_blank" rel="noopener noreferrer"><ExternalLink size={18} />공식 신청</a>
            <a class="button secondary" href="/dashboard/">대시보드</a>
            <a class="button secondary" href="/support/">목록으로</a>
          </div>
        </div>
        <div class="card">
          <h2><Bell size={18} />알림 설계</h2>
          <p>다음 단계에서 저장, 마감 7일 전 알림, 새 일치 정책 알림으로 확장할 수 있는 구조입니다.</p>
        </div>
      </aside>
    </div>
  </section>

  <div class="sticky-detail-cta" aria-label="상세 페이지 빠른 실행">
    <span>{policy.title}</span>
    <a class="button" href={policy.officialUrl} target="_blank" rel="noopener noreferrer"><ExternalLink size={17} />공식 신청하기</a>
    <button class="button secondary" type="button"><Bell size={17} />알림</button>
  </div>
</BaseLayout>
