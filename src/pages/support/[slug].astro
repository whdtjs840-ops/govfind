---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CheckCircle2, ExternalLink, FileCheck2 } from "@lucide/astro";
import { policies } from "../../data/policies";

export function getStaticPaths() {
  return policies.map((policy) => ({ params: { slug: policy.slug }, props: { policy } }));
}

const { policy } = Astro.props;
const matchScore = Math.min(96, 72 + policy.matchReasons.length * 4 + (policy.applyOnline ? 8 : 0) + (policy.status === "마감임박" ? 5 : 0));
const apiDetails = policy.apiDetails;
const hasApiDetails = Boolean(apiDetails?.target || apiDetails?.criteria || apiDetails?.benefit || apiDetails?.application);

function paragraphs(value?: string) {
  return (value ?? "")
    .split(/\n{2,}|\n/)
    .map((item) => item.trim())
    .filter(Boolean)
    .slice(0, 5);
}
---

<BaseLayout title={`${policy.title} - 자격조건과 공식 신청처 | GovFind`} description={policy.summary} canonical={`/support/${policy.slug}/`}>
  <section class="detail-hero">
    <div class="wrap detail-grid">
      <div>
        <p class="eyebrow">{policy.category}</p>
        <h1>{policy.title}</h1>
        <p class="lead">{policy.summary}</p>
        <div class="toolbar">
          <span class="badge score">예상 적합도 {matchScore}%</span>
          <span class="badge">{policy.source}</span>
          <span class="badge warn">{policy.region}</span>
          <span class="badge deadline">{policy.dday}</span>
        </div>
      </div>
      <aside class="card cta-card">
        <p class="eyebrow">첫 화면 핵심 정보</p>
        <dl class="summary-dl">
          <div><dt>예상 적합도</dt><dd>{matchScore}%</dd></div>
          <div><dt>예상 지원</dt><dd>{policy.amount}</dd></div>
          <div><dt>신청 기간</dt><dd>{policy.deadline}</dd></div>
          <div><dt>대상</dt><dd>{policy.targetGroup}</dd></div>
        </dl>
        <a class="button" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug}><ExternalLink size={18} />공식 신청처 이동</a>
        <p class="notice">GovFind는 자격을 단정하지 않습니다. 최종 신청과 판정은 공식 기관에서 확인하세요.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <article class="grid">
        <section class="card">
          <h2><CheckCircle2 size={20} />왜 추천되었나요?</h2>
          <ul class="list-clean">
            {policy.matchReasons.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="card">
          <h2>자격 체크</h2>
          <dl class="summary-dl">
            <div><dt>생애주기</dt><dd>{policy.lifeStage}</dd></div>
            <div><dt>소득 기준</dt><dd>{policy.income}</dd></div>
            <div><dt>온라인 신청</dt><dd>{policy.applyOnline ? "가능성 높음" : "공고 확인 필요"}</dd></div>
            <div><dt>대상 설명</dt><dd>{policy.audience}</dd></div>
          </dl>
        </section>

        {hasApiDetails && (
          <section class="card">
            <h2>공공데이터 상세 기준</h2>
            {apiDetails?.target && (
              <div class="detail-copy">
                <h3>지원 대상</h3>
                {paragraphs(apiDetails.target).map((item) => <p>{item}</p>)}
              </div>
            )}
            {apiDetails?.criteria && (
              <div class="detail-copy">
                <h3>선정 기준</h3>
                {paragraphs(apiDetails.criteria).map((item) => <p>{item}</p>)}
              </div>
            )}
          </section>
        )}

        <section class="card">
          <h2>지원 내용</h2>
          <ul class="list-clean">
            {policy.benefits.map((item) => <li>{item}</li>)}
          </ul>
          {apiDetails?.benefit && (
            <div class="detail-copy">
              {paragraphs(apiDetails.benefit).map((item) => <p>{item}</p>)}
            </div>
          )}
        </section>
        <section class="card">
          <h2><FileCheck2 size={20} />필요 서류</h2>
          <ul class="list-clean">
            {policy.documents.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="card">
          <h2>신청 방법</h2>
          <p>{policy.apply}</p>
          {apiDetails?.application && (
            <div class="detail-copy">
              {paragraphs(apiDetails.application).map((item) => <p>{item}</p>)}
            </div>
          )}
          <p class="notice">원문 출처: <a class="text-link" href={policy.officialSourceUrl} target="_blank" rel="noopener noreferrer">{policy.source}</a></p>
        </section>
        <section class="card">
          <h2>신청 전 확인 순서</h2>
          <div class="progress-steps" aria-label="신청 전 확인 순서">
            <span class="active">대상 확인</span>
            <span class="active">서류 확인</span>
            <span>마감 확인</span>
            <span>공식 이동</span>
            <span>기관 제출</span>
          </div>
        </section>
        <section class="card">
          <h2>FAQ</h2>
          <div class="faq-list">
            {policy.faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      </article>
      <aside class="aside">
        <div class="card">
          <h2>공식 확인</h2>
          <p>신청 전 기관명, 문의처, 마감일, 필요서류를 공식 페이지에서 다시 확인하세요.</p>
          <ul class="list-clean">
            <li>기관: {policy.agency}</li>
            <li>문의: {policy.contact}</li>
            <li>마감: {policy.deadline}</li>
          </ul>
          <div class="toolbar">
            <a class="button" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug}><ExternalLink size={18} />공식 신청</a>
            <a class="button secondary" href="/support/">목록으로</a>
          </div>
        </div>
        <div class="card">
          <h2>정보 확인 원칙</h2>
          <p>민간 사이트 설명은 탐색용입니다. 신청 가능 여부, 접수 기간, 제출 서류는 공식 기관 안내를 기준으로 확인하세요.</p>
        </div>
      </aside>
    </div>
  </section>

  <div class="sticky-detail-cta" aria-label="상세 페이지 빠른 실행">
    <span>{policy.title}</span>
    <a class="button" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug}><ExternalLink size={17} />공식 신청하기</a>
    <a class="button secondary" href="/support/">목록으로</a>
  </div>
</BaseLayout>
