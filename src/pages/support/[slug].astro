---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ExternalLink } from "@lucide/astro";
import { policies } from "../../data/policies";
import { derivePolicyTags } from "../../utils/derivedTags";
import { sourceLabel } from "../../utils/sourceNames";
import {
  cleanSummary,
  deadlineBasisText,
  deadlineDisplay,
  dedupePolicies,
  getDisplayRegion,
  getDisplayStatus,
  isDeadlineSoonPolicy,
  isSearchOnlyPolicy,
  shouldRequireOfficialConfirmation
} from "../../utils/policyUtils";

export function getStaticPaths() {
  return policies.map((policy) => ({ params: { slug: policy.slug }, props: { policy } }));
}

const { policy } = Astro.props;
const { relatedBySlug } = dedupePolicies(policies);
const duplicateSources = relatedBySlug.get(policy.slug) ?? [];
const apiDetails = policy.apiDetails;
const detailTarget = apiDetails?.target || policy.audience || policy.targetGroup;
const detailBenefit = apiDetails?.benefit || policy.benefits.join("\n");
const detailApply = apiDetails?.application || policy.apply;
const detailCriteria = apiDetails?.criteria || "";
const deadlineLabel = deadlineDisplay(policy);
const deadlineBasis = deadlineBasisText(policy);
const displayStatus = getDisplayStatus(policy);
const displayRegion = getDisplayRegion(policy);
const showOfficialConfirmation = shouldRequireOfficialConfirmation(policy);
const showOfficialConfirmationBlock =
  showOfficialConfirmation ||
  policy.statusConfidence === "unknown" ||
  policy.dateConfidence === "unknown" ||
  policy.applicationPeriodLabel === "공식 공고 확인";
const sourceAdapter =
  policy.source.includes("정부24") ? "gov24/v3 serviceList·serviceDetail" :
  policy.source.includes("복지로") || policy.source.includes("복지") ? "NationalWelfare V001" :
  policy.source.includes("K-Startup") ? "K-Startup 공공데이터" :
  "공식 원문/기관 안내";
const sourceName = sourceLabel(policy.source);
const sourceWithAgency = sourceName === policy.agency ? `${sourceName} 안내` : `${sourceName}와 ${policy.agency} 안내`;
const relatedPolicies = policies
  .filter((item) => !isSearchOnlyPolicy(item) && item.slug !== policy.slug && (item.category === policy.category || (policy.region && item.region === policy.region) || item.tags.some((tag) => policy.tags.includes(tag))))
  .slice(0, 4);
const comparisonRows = relatedPolicies.slice(0, 3);
const derivedTags = derivePolicyTags(policy).slice(0, 6);

function lines(value?: string, max = 12) {
  return (value ?? "")
    .split(/\n{2,}|\n|(?<=다\.)\s+|(?<=요\.)\s+/)
    .map((item) => item.trim())
    .filter(Boolean)
    .slice(0, max);
}

const targetLines = lines(detailTarget, 10);
const benefitLines = lines(detailBenefit, 10);
const applyLines = lines(detailApply, 10);
const criteriaLines = lines(detailCriteria, 8);
const summaryText = cleanSummary(policy.summary);
const documentLines = policy.documents.map((item) => item.trim()).filter(Boolean);
const faqItems = policy.faq.filter((item) => item.q?.trim() && item.a?.trim());
const warningLines = (policy.warnings ?? []).map((item) => item.trim()).filter(Boolean);
const contentHighlights = [
  { label: "지원 대상", value: policy.targetGroup || targetLines[0] || policy.audience },
  { label: "지원 내용", value: cleanSummary(policy.amount || benefitLines[0] || "") },
  { label: "신청 방법", value: applyLines[0] || policy.apply },
  { label: "공식 출처", value: `${sourceLabel(policy.source)} · ${policy.agency}` }
].filter((item) => item.value);

function isGenericOfficialUrl(value: string) {
  try {
    const url = new URL(value);
    const genericHosts = new Set([
      "www.gov.kr",
      "www.bokjiro.go.kr",
      "www.k-startup.go.kr",
      "www.bizinfo.go.kr",
      "www.work24.go.kr",
      "www.hometax.go.kr",
      "www.nhis.or.kr"
    ]);
    return genericHosts.has(url.hostname) && ["", "/", "/web/index.do", "/index.do"].includes(url.pathname);
  } catch {
    return false;
  }
}

const officialLinkIsGeneric = isGenericOfficialUrl(policy.officialUrl);
const officialCtaLabel = officialLinkIsGeneric ? "공식 사이트에서 확인" : showOfficialConfirmation ? "공식 공고 확인하기" : "공식 신청처 바로가기";
const applicationChecklist = [
  { label: "1. 대상 확인", value: policy.targetGroup || targetLines[0] || "공식 신청처에서 확인" },
  { label: "2. 기간 확인", value: `${policy.deadline} · ${deadlineLabel}` },
  { label: "3. 공식 접수", value: `${sourceLabel(policy.source)}에서 최종 신청` }
];
const anchorItems = [
  { href: "#summary", label: "요약" },
  { href: "#target", label: "지원대상" },
  { href: "#benefit", label: "지원내용" },
  { href: "#apply", label: "신청방법" },
  ...(documentLines.length ? [{ href: "#documents", label: "필요서류" }] : []),
  ...(faqItems.length ? [{ href: "#faq", label: "FAQ" }] : []),
  { href: "#official-check", label: "공식확인" }
];
const categorySlug =
  policy.category === "복지" ? "welfare" :
  policy.category === "주거" ? "housing" :
  policy.category === "고용" ? "job" :
  policy.category === "청년" ? "youth" :
  policy.category === "교육" ? "education" :
  policy.category === "보건의료" ? "health" :
  policy.category === "농림어업" ? "farming" :
  policy.category === "소상공인" ? "small-business" :
  "startup";
const quickCheckItems = [
  { label: "대상", value: policy.targetGroup || targetLines[0] || "공식 신청처 확인 필요" },
  { label: "지역", value: displayRegion },
  { label: "신청기간", value: `${policy.deadline} · ${deadlineLabel}` },
  { label: "지원내용", value: cleanSummary(policy.amount || benefitLines[0] || "공식 신청처 확인 필요") },
  { label: "신청방식", value: policy.applyOnline ? "온라인 신청 가능" : "공식 신청처 확인 필요" },
  { label: "필요서류", value: policy.documents.slice(0, 2).join(", ") || "공식 신청처 확인 필요" },
  { label: "공식 신청처", value: sourceLabel(policy.source) },
  { label: "마지막 확인일", value: policy.updatedAt || "공식 신청처 확인 필요" }
];
const applyPath = [
  "대상·지역 조건 확인",
  "기간·필요서류 확인",
  "공식 신청처에서 최종 신청"
];

function compactText(value?: string) {
  return (value ?? "").replace(/\s+/g, " ").trim();
}

function truncateMeta(value: string, maxLength = 155) {
  const text = compactText(value);
  return text.length > maxLength ? `${text.slice(0, maxLength - 1)}…` : text;
}

const seoAgency = compactText(policy.agency) || sourceLabel(policy.source);
const seoCategory = compactText(policy.category) || "정부지원";
const seoDescription = truncateMeta(
  `${seoAgency}의 ${seoCategory} 관련 지원정책입니다. 지원 대상, 신청 방법, 공식 신청처를 GovFind에서 확인하세요.`
);
---

<BaseLayout title={`${policy.title} | GovFind`} description={seoDescription} canonical={`/support/${policy.slug}/`}>
  <section class="policy-doc-head">
    <div class="wrap doc-wrap">
      <nav class="breadcrumb" aria-label="현재 위치">
        <a href="/">홈</a>
        <span>/</span>
        <a href="/support/">정책 목록</a>
        <span>/</span>
        <a href={`/category/${categorySlug}/`}>{policy.category}</a>
      </nav>

      <div class="policy-doc-title">
        <div class="policy-status-row">
          <span class={isDeadlineSoonPolicy(policy) ? "badge deadline" : "badge warn"}>{displayStatus}</span>
          <span class="badge">{policy.category}</span>
          <span class="badge soft">{deadlineLabel}</span>
          <span class="badge soft">{sourceLabel(policy.source)}</span>
        </div>
        <h1>{policy.title}</h1>
        <p class="doc-meta">업데이트 {policy.updatedAt} · {policy.agency}</p>
        {derivedTags.length > 0 && (
          <div class="policy-derived-tags" aria-label="세부 태그">
            {derivedTags.map((tag) => (
              <a class="policy-tag-pill" href={`/support/?tag=${encodeURIComponent(tag)}`}>{tag}</a>
            ))}
          </div>
        )}
        <div class="doc-primary-actions">
          <a class="button doc-primary" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug} data-official-link-kind={officialLinkIsGeneric ? "generic" : "direct"}>
            <ExternalLink size={18} />{officialCtaLabel}
          </a>
          <a class="button secondary" href="/support/">목록으로 돌아가기</a>
        </div>
        <p class="doc-cta-helper">대상과 기간을 확인한 뒤 공식 기관 페이지에서 신청을 완료하세요.</p>
        <div class="doc-next-action" aria-label="다음 행동 안내">
          <strong>다음 행동</strong>
          <span>지원 대상과 신청기간을 확인했다면 위의 공식 신청처 버튼으로 이동하세요.</span>
        </div>
        <div class="doc-cta-summary" aria-label="핵심 신청 정보">
          <div>
            <span>신청 상태</span>
            <strong>{displayStatus}</strong>
          </div>
          <div>
            <span>신청 기간</span>
            <strong>{deadlineLabel}</strong>
          </div>
          <div>
            <span>공식 출처</span>
            <strong>{sourceLabel(policy.source)}</strong>
          </div>
        </div>
        <div class="doc-official-direct" aria-label="공식 신청 바로가기">
          <div>
            <span>신청은 공식 기관에서 진행됩니다</span>
            <strong>GovFind에서 조건을 확인한 뒤 공식 신청처로 바로 이동하세요.</strong>
          </div>
          <a class="button doc-primary" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug} data-official-link-kind={officialLinkIsGeneric ? "generic" : "direct"}>
            <ExternalLink size={18} />{officialCtaLabel}
          </a>
        </div>
        <div class="doc-action-brief" aria-label="핵심 확인 요약">
          <span>1. 대상 확인</span>
          <span>2. 기간 확인</span>
          <span>3. 공식 신청처 이동</span>
        </div>
      </div>

      {showOfficialConfirmationBlock ? (
        <div class="doc-safety-note" role="note">
          <strong>신청 전 확인하세요</strong>
          <span>이 정책은 공식 출처 기준으로 정리되었습니다. 신청기간, 자격, 지원 내용은 변경될 수 있으므로 신청 전 공식 공고를 확인하세요.</span>
        </div>
      ) : (
        <div class="doc-safety-note" role="note">
          <strong>신청 전 안내</strong>
          <span>GovFind는 자격을 단정하지 않습니다. 대상, 기간, 서류를 빠르게 확인한 뒤 최종 신청은 공식 기관에서 진행하세요.</span>
        </div>
      )}

      <section class="doc-application-panel" aria-label="신청 진행 순서">
        <div class="doc-application-copy">
          <span>신청 동선</span>
          <h2>조건만 확인하고 공식 신청처로 바로 이동하세요</h2>
          <p>GovFind는 핵심 정보를 정리하고, 실제 접수와 자격 판정은 공식 기관 페이지에서 진행됩니다.</p>
        </div>
        <div class="doc-application-steps">
          {applicationChecklist.map((item) => (
            <div>
              <strong>{item.label}</strong>
              <span>{item.value}</span>
            </div>
          ))}
        </div>
        <a class="button doc-primary" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug} data-official-link-kind={officialLinkIsGeneric ? "generic" : "direct"}>
          <ExternalLink size={18} />{officialCtaLabel}
        </a>
      </section>

      <section class="quick-check-box" aria-label="신청 전 빠른 확인">
        <div class="quick-check-head">
          <h2>신청 전 빠른 확인</h2>
        </div>
        <dl>
          {quickCheckItems.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <div class="doc-apply-path" aria-label="신청 확인 순서">
        {applyPath.map((item, index) => (
          <div>
            <span>{index + 1}</span>
            <strong>{item}</strong>
          </div>
        ))}
      </div>

      <nav class="doc-anchor-nav" aria-label="상세 섹션 이동">
        {anchorItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
  </section>

  <section class="section policy-doc-section">
    <div class="wrap doc-wrap">
      <article class="policy-doc">
        <section class="doc-block" id="summary">
          <h2>핵심 요약</h2>
          <p>{summaryText}</p>
          <div class="doc-highlight-grid" aria-label="핵심 정보 요약">
            {contentHighlights.map((item) => (
              <div class="doc-highlight-card">
                <span>{item.label}</span>
                <strong>{item.value}</strong>
              </div>
            ))}
          </div>
        </section>

        <section class="doc-block">
          <h3>기본 정보</h3>
          <dl class="doc-info-table">
            <div><dt>분류</dt><dd>{policy.category}</dd></div>
            <div><dt>담당부처</dt><dd>{policy.agency}</dd></div>
            <div><dt>지역</dt><dd>{displayRegion}</dd></div>
            <div><dt>신청기간</dt><dd>{policy.deadline} <strong>{deadlineLabel}</strong></dd></div>
            <div><dt>지원규모</dt><dd>{policy.amount}</dd></div>
            <div><dt>안내처</dt><dd>{sourceLabel(policy.source)}</dd></div>
          </dl>
        </section>

        <section class="doc-block">
          <h3>출처와 확인 기준</h3>
          <dl class="doc-info-table">
            <div><dt>출처</dt><dd>{sourceLabel(policy.source)}</dd></div>
            <div><dt>수집 기준</dt><dd>{sourceAdapter}</dd></div>
            <div><dt>마지막 출처 확인일</dt><dd>{policy.updatedAt}</dd></div>
            <div><dt>링크 검증 상태</dt><dd>공식 신청처 연결 제공 · 접수 가능 여부는 공식 기관 확인</dd></div>
          </dl>
          <p class="notice">GovFind는 원문 출처, 기관명, 신청 링크, 마지막 확인일을 함께 보여주어 사용자가 공식 신청 전 빠르게 검토할 수 있도록 돕습니다.</p>
        </section>

        {warningLines.length > 0 && (
          <section class="doc-block">
            <h3>확인 안내</h3>
            <ul class="doc-list">
              {warningLines.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )}

        <section class="doc-block">
          <h3>근거 요약</h3>
          <p>
            이 페이지는 {sourceWithAgency}를 기준으로 {policy.title}의 대상, 지원내용, 신청기간, 필요서류를 같은 순서로 정리했습니다.
            GovFind는 신청 가능성을 단정하지 않으며, 최종 접수 가능 여부와 자격 판정은 공식 신청처에서 확인해야 합니다.
          </p>
          <p class="notice">{deadlineBasis}</p>
        </section>

        {(apiDetails?.benefit || apiDetails?.target || apiDetails?.application) && (
          <section class="doc-block">
            <h3>공식 원문 요약</h3>
            {apiDetails?.target && <p><strong>대상:</strong> {cleanSummary(apiDetails.target)}</p>}
            {apiDetails?.benefit && <p><strong>지원내용:</strong> {cleanSummary(apiDetails.benefit)}</p>}
            {apiDetails?.application && <p><strong>신청:</strong> {cleanSummary(apiDetails.application)}</p>}
            <p class="notice">원문 표현은 기관 자료 기준이며, 오탈자처럼 보이는 내용도 공식 신청처에서 최종 확인해야 합니다.</p>
          </section>
        )}

        <section class="doc-block" id="target">
          <h3>지원 대상</h3>
          {targetLines.length ? targetLines.map((item) => <p>{item}</p>) : <p>공식 상세 페이지에서 지원 대상을 확인해야 합니다.</p>}
        </section>

        {criteriaLines.length > 0 && (
          <section class="doc-block">
            <h3>선정 기준</h3>
            {criteriaLines.map((item) => <p>{item}</p>)}
          </section>
        )}

        <section class="doc-block" id="benefit">
          <h3>지원 내용</h3>
          {benefitLines.length ? (
            <ul class="doc-list">
              {benefitLines.map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <p>지원 내용은 공식 공고를 기준으로 확인해야 합니다.</p>
          )}
        </section>

        <section class="doc-block" id="apply">
          <h3>신청 방법</h3>
          {applyLines.length ? applyLines.map((item) => <p>{item}</p>) : <p>복지로 또는 소관 기관의 공식 신청 안내를 확인합니다.</p>}
          <p class="notice">GovFind는 자격을 단정하지 않고 조건 확인을 돕습니다. 신청 전 기관명, 제출 서류, 접수 기간을 공식 페이지에서 다시 확인하세요.</p>
          <div class="doc-inline-cta">
            <span>신청 준비가 끝났다면</span>
            <a class="button doc-primary" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug} data-official-link-kind={officialLinkIsGeneric ? "generic" : "direct"}>
              <ExternalLink size={17} />{officialCtaLabel}
            </a>
          </div>
        </section>

        {documentLines.length > 0 && (
          <section class="doc-block" id="documents">
            <h3>필요 서류</h3>
            <ul class="doc-list">
              {documentLines.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )}

        {faqItems.length > 0 && (
          <section class="doc-block" id="faq">
            <h3>자주 묻는 질문</h3>
            <div class="faq-list doc-faq">
              {faqItems.map((item) => (
                <details>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <section class="doc-block" id="official-check">
          <h3>신청 전 확인사항</h3>
          <ul class="doc-list">
            <li>지원 대상, 소득 기준, 거주지 기준은 공식 신청처에서 다시 확인하세요.</li>
            <li>신청 기간과 제출 서류는 기관 사정에 따라 달라질 수 있습니다.</li>
            <li>GovFind는 공식 출처 기준으로 정보를 정리하며, 최종 접수와 자격 판정은 공식 기관에서 진행합니다.</li>
          </ul>
          {duplicateSources.length > 0 && (
            <>
              <h3>관련 공식 원문</h3>
              <ul class="related-links">
                {duplicateSources.map((item) => (
                  <li><a href={item.officialSourceUrl || item.officialUrl} target="_blank" rel="noopener noreferrer">{item.title} · {sourceLabel(item.source)}</a></li>
                ))}
              </ul>
            </>
          )}
        </section>

        {comparisonRows.length > 0 && (
          <section class="doc-block">
            <h3>유사 정책 비교</h3>
            <div class="compare-table-wrap">
              <table class="compare-table">
                <thead>
                  <tr>
                    <th>정책</th>
                    <th>분류</th>
                    <th>지역</th>
                    <th>신청기간</th>
                    <th>공식확인</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>{policy.title}</strong></td>
                    <td>{policy.category}</td>
                    <td>{displayRegion}</td>
                    <td>{policy.deadline} · {deadlineLabel}</td>
                    <td><a href={policy.officialUrl} target="_blank" rel="noopener noreferrer">공식 신청처</a></td>
                  </tr>
                  {comparisonRows.map((item) => (
                    <tr>
                      <td><a href={`/support/${item.slug}/`}>{item.title}</a></td>
                      <td>{item.category}</td>
                      <td>{item.region}</td>
                      <td>{item.deadline} · {deadlineDisplay(item)}</td>
                      <td><a href={item.officialUrl} target="_blank" rel="noopener noreferrer">공식 신청처</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </article>

      <aside class="doc-side">
        <div class="card doc-side-card">
          <h2>출처 카드</h2>
          <dl class="summary-dl">
            <div><dt>출처</dt><dd>{sourceLabel(policy.source)}</dd></div>
            <div><dt>확인일</dt><dd>{policy.updatedAt}</dd></div>
            <div><dt>링크</dt><dd><a href={policy.officialSourceUrl || policy.officialUrl} target="_blank" rel="noopener noreferrer">공식 원문</a></dd></div>
          </dl>
        </div>

        <div class="card doc-side-card">
          <h2>공식 확인</h2>
          <dl class="summary-dl">
            <div><dt>기관</dt><dd>{policy.agency}</dd></div>
            <div><dt>문의</dt><dd>{policy.contact}</dd></div>
            <div><dt>마감</dt><dd>{policy.deadline}</dd></div>
          </dl>
        </div>

        {relatedPolicies.length > 0 && (
          <div class="card doc-side-card">
            <h2>함께 볼 정책</h2>
            <ul class="side-policy-list">
              {relatedPolicies.map((item) => (
                <li>
                  <a href={`/support/${item.slug}/`}>
                    <strong>{item.title}</strong>
                    <span>{item.category} · {deadlineDisplay(item)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  <div class="sticky-detail-cta" aria-label="상세 페이지 빠른 실행">
    <span>{policy.title}</span>
    <a class="button" href={policy.officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_apply_click" data-policy={policy.slug} data-official-link-kind={officialLinkIsGeneric ? "generic" : "direct"}>
      <ExternalLink size={17} />{officialCtaLabel}
    </a>
    <a class="button secondary" href="/support/">목록으로</a>
  </div>
</BaseLayout>
