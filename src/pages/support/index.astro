---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PolicyCard from "../../components/PolicyCard.astro";
import { Search, SlidersHorizontal } from "@lucide/astro";
import { categories, lifeStages, policies, popularKeywords, regions, sources } from "../../data/policies";
---

<BaseLayout title="전체 정부지원금 목록 - GovFind" description="정부지원금을 키워드, 카테고리, 지역, 모집 상태, 온라인 신청 가능 여부로 검색하고 비교하세요.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">전체 지원사업</p>
      <h1>정부지원금 전체 목록</h1>
      <p class="lead">대표 지원사업을 카테고리, 지역, 모집 상태, 공식 출처 기준으로 좁혀볼 수 있습니다.</p>
      <form class="toolbar search-toolbar" action="/support/" method="get">
        <input class="input" name="q" type="search" placeholder="청년 월세, 소상공인 자금, 육아 지원금" />
        <select class="input" name="category" aria-label="카테고리">
          <option value="">전체 카테고리</option>
          {categories.map((item) => <option value={item}>{item}</option>)}
        </select>
        <select class="input" name="region" aria-label="지역">
          <option value="">전체 지역</option>
          {regions.map((item) => <option value={item}>{item}</option>)}
        </select>
        <button class="button" type="submit" data-event="search_submit">검색</button>
      </form>
      <div class="quick-tags" aria-label="인기 검색어">
        {popularKeywords.map((keyword) => <a class="chip" href={`/support/?q=${encodeURIComponent(keyword)}`}>{keyword}</a>)}
      </div>
    </div>
  </section>

  <section class="section tight profile-lite-band">
    <div class="wrap profile-lite">
      <div>
        <p class="eyebrow">비회원 라이트 프로필</p>
        <h2>나이·지역·가구상황만으로 먼저 좁혀보세요</h2>
      </div>
      <form class="profile-lite-form" action="/support/" method="get">
        <input class="input" name="age" inputmode="numeric" placeholder="나이" aria-label="나이" />
        <select class="input" name="region" aria-label="지역">
          <option value="">지역</option>
          {regions.map((item) => <option value={item}>{item}</option>)}
        </select>
        <select class="input" name="household" aria-label="가구상황">
          <option value="">가구상황</option>
          <option>1인가구</option>
          <option>출산가구</option>
          <option>저소득</option>
          <option>사업자</option>
        </select>
        <button class="button" type="submit">간단 자격 확인</button>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="wrap results-layout">
      <details class="filter-card card" aria-label="상세 필터" open>
        <summary><SlidersHorizontal size={18} />필터</summary>
        <label>생애주기
          <select class="input" data-filter="lifeStage">
            <option value="">전체</option>
            {lifeStages.map((item) => <option value={item}>{item}</option>)}
          </select>
        </label>
        <label>모집 상태
          <select class="input" data-filter="status">
            <option value="">전체</option>
            <option>모집중</option>
            <option>마감임박</option>
            <option>상시</option>
            <option>예정</option>
          </select>
        </label>
        <label>출처
          <select class="input" data-filter="source">
            <option value="">전체</option>
            {sources.map((item) => <option value={item}>{item}</option>)}
          </select>
        </label>
        <label class="check-row">
          <input type="checkbox" data-filter="online" />
          온라인 신청 가능
        </label>
        <div class="quick-tags">
          <a class="chip" href="/support/?q=청년">청년</a>
          <a class="chip" href="/support/?q=소상공인">소상공인</a>
          <a class="chip" href="/support/?q=마감">마감</a>
        </div>
      </details>

      <div>
        <div class="result-head">
          <div>
            <p class="eyebrow"><span id="result-count">{policies.length}</span>개 결과</p>
            <h2>적합 이유와 공식 신청처를 함께 확인하세요</h2>
            <p class="notice">카드에는 기관명, 마감일, 출처, 적합 이유를 함께 표시합니다.</p>
          </div>
          <select class="input small" data-sort aria-label="정렬">
            <option value="recommended">추천순</option>
            <option value="deadline">마감임박순</option>
            <option value="popular">인기순</option>
            <option value="online">온라인 신청 우선</option>
          </select>
        </div>
        <div class="grid cols-2 result-grid">
          {policies.map((policy) => <PolicyCard policy={policy} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section tight dashboard-teaser">
    <div class="wrap split wide">
      <div>
        <p class="eyebrow">공식 신청 전 체크</p>
        <h2>민간 사이트에서 끝내지 말고 공식 원문까지 확인하세요</h2>
        <p class="lead">GovFind는 조건을 정리해 보여주는 정보 탐색 사이트입니다. 최종 자격 판정과 접수는 정부24, 복지로, 고용24, K-Startup 등 공식 기관에서 진행됩니다.</p>
        <div class="toolbar"><a class="button secondary" href="/sources/">공식 데이터 출처 보기</a></div>
      </div>
      <div class="notification-grid">
        <div><strong>대상 조건</strong><span>나이·소득·지역·가구 기준 확인</span></div>
        <div><strong>신청 기간</strong><span>마감일과 예산 소진 여부 확인</span></div>
        <div><strong>필요 서류</strong><span>계약서·증빙·신분 서류 확인</span></div>
        <div><strong>공식 원문</strong><span>최종 신청은 기관 페이지에서 진행</span></div>
      </div>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    const keyword = params.get("q")?.trim() ?? "";
    const selectedCategory = params.get("category")?.trim() ?? "";
    const selectedRegion = params.get("region")?.trim() ?? "";
    const selectedLife = params.get("lifeStage")?.trim() ?? "";
    const selectedStatus = params.get("status")?.trim() ?? "";
    const selectedSource = params.get("source")?.trim() ?? "";
    const selectedOnline = params.get("online") === "true";
    const selectedSort = params.get("sort")?.trim() ?? "recommended";
    const input = document.querySelector<HTMLInputElement>('input[name="q"]');
    const category = document.querySelector<HTMLSelectElement>('select[name="category"]');
    const region = document.querySelector<HTMLSelectElement>('select[name="region"]');
    const count = document.querySelector("#result-count");
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".support-card"));
    const lifeStage = document.querySelector<HTMLSelectElement>('[data-filter="lifeStage"]');
    const status = document.querySelector<HTMLSelectElement>('[data-filter="status"]');
    const source = document.querySelector<HTMLSelectElement>('[data-filter="source"]');
    const online = document.querySelector<HTMLInputElement>('[data-filter="online"]');
    const sort = document.querySelector<HTMLSelectElement>("[data-sort]");
    const resultGrid = document.querySelector<HTMLElement>(".result-grid");

    if (input) input.value = keyword;
    if (category) category.value = selectedCategory;
    if (region) region.value = selectedRegion;
    if (lifeStage) lifeStage.value = selectedLife;
    if (status) status.value = selectedStatus;
    if (source) source.value = selectedSource;
    if (online) online.checked = selectedOnline;
    if (sort) sort.value = selectedSort;

    function ddayRank(value: string) {
      if (value.startsWith("D-")) return Number(value.replace("D-", "")) || 999;
      if (value === "상시") return 500;
      if (value === "예정") return 700;
      return 999;
    }

    function syncUrl() {
      const next = new URLSearchParams();
      if (keyword) next.set("q", keyword);
      if (selectedCategory) next.set("category", selectedCategory);
      if (selectedRegion) next.set("region", selectedRegion);
      if (lifeStage?.value) next.set("lifeStage", lifeStage.value);
      if (status?.value) next.set("status", status.value);
      if (source?.value) next.set("source", source.value);
      if (online?.checked) next.set("online", "true");
      if (sort?.value && sort.value !== "recommended") next.set("sort", sort.value);
      const query = next.toString();
      window.history.replaceState(null, "", query ? `/support/?${query}` : "/support/");
    }

    function sortCards() {
      if (!resultGrid || !sort) return;
      const sorted = [...cards].sort((a, b) => {
        if (sort.value === "deadline") return ddayRank(a.dataset.dday ?? "") - ddayRank(b.dataset.dday ?? "");
        if (sort.value === "popular") return Number(b.dataset.views ?? 0) - Number(a.dataset.views ?? 0);
        if (sort.value === "online") return Number(b.dataset.online === "true") - Number(a.dataset.online === "true");
        return Number(b.dataset.score ?? 0) - Number(a.dataset.score ?? 0);
      });
      for (const card of sorted) resultGrid.appendChild(card);
    }

    function applyFilters() {
      const lifeValue = lifeStage?.value ?? "";
      const statusValue = status?.value ?? "";
      const sourceValue = source?.value ?? "";
      const onlineOnly = online?.checked ?? false;
      let visible = 0;

      for (const card of cards) {
        const text = card.dataset.search ?? "";
        const cardCategory = card.dataset.category ?? "";
        const cardRegion = card.dataset.region ?? "";
        const cardStatus = card.dataset.status ?? "";
        const cardSource = card.dataset.source ?? "";
        const cardOnline = card.dataset.online === "true";
        const matchKeyword = !keyword || text.includes(keyword);
        const matchCategory = !selectedCategory || cardCategory === selectedCategory;
        const matchRegion = !selectedRegion || cardRegion === selectedRegion || cardRegion === "전국" || cardRegion === "지역별";
        const matchLife = !lifeValue || text.includes(lifeValue);
        const matchStatus = !statusValue || cardStatus === statusValue;
        const matchSource = !sourceValue || cardSource === sourceValue;
        const matchOnline = !onlineOnly || cardOnline;
        const isVisible = matchKeyword && matchCategory && matchRegion && matchLife && matchStatus && matchSource && matchOnline;
        card.style.display = isVisible ? "" : "none";
        if (isVisible) visible += 1;
      }

      if (count) count.textContent = String(visible);
      sortCards();
      syncUrl();
    }

    lifeStage?.addEventListener("change", applyFilters);
    status?.addEventListener("change", applyFilters);
    source?.addEventListener("change", applyFilters);
    online?.addEventListener("change", applyFilters);
    sort?.addEventListener("change", applyFilters);
    applyFilters();
  </script>
</BaseLayout>
