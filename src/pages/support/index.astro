---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PolicyCard from "../../components/PolicyCard.astro";
import QuickConditionSearch from "../../components/QuickConditionSearch.astro";
import { CheckCircle2, Search, SlidersHorizontal } from "@lucide/astro";
import { categories, categoryGroups, lifeStages, policies, regions } from "../../data/policies";
import { publicSourceOptions, sourceLabel } from "../../utils/sourceNames";
import { dedupePolicies, isSearchOnlyPolicy } from "../../utils/policyUtils";

const { canonical: displayPolicies } = dedupePolicies(policies);
const publicDisplayPolicies = displayPolicies.filter((policy) => !isSearchOnlyPolicy(policy));

const params = Astro.url.searchParams;
const selectedQ = params.get("q") ?? "";
const selectedCategory = params.get("category") ?? "";
const selectedRegion = params.get("region") ?? "";
const selectedSource = sourceLabel(params.get("source") ?? "");
const selectedStatus = params.get("status") ?? "";

const counts = {
  all: publicDisplayPolicies.length,
  deadline: publicDisplayPolicies.filter((policy) => policy.status === "마감임박" || /^D-/.test(policy.dday)).length,
  gov24: publicDisplayPolicies.filter((policy) => policy.source.includes("정부24")).length,
  welfare: publicDisplayPolicies.filter((policy) => policy.source.includes("복지로")).length,
  kstartup: publicDisplayPolicies.filter((policy) => policy.source.includes("K-Startup")).length,
  youth: publicDisplayPolicies.filter((policy) => `${policy.title} ${policy.tags.join(" ")}`.includes("청년")).length,
  smallBusiness: publicDisplayPolicies.filter((policy) => `${policy.title} ${policy.tags.join(" ")}`.includes("소상공인")).length
};

function supportHref(next: Record<string, string>) {
  const query = new URLSearchParams();
  for (const [key, value] of Object.entries(next)) {
    if (value) query.set(key, value);
  }
  const value = query.toString();
  return value ? `/support/?${value}` : "/support/";
}

const quickTabs = [
  { label: "전체", count: counts.all, href: supportHref({}), active: !selectedQ && !selectedCategory && !selectedSource && !selectedStatus },
  { label: "마감임박", count: counts.deadline, href: supportHref({ status: "마감임박" }), active: selectedStatus === "마감임박" },
  { label: "정부24", count: counts.gov24, href: supportHref({ source: "정부24" }), active: selectedSource === "정부24" },
  { label: "복지로", count: counts.welfare, href: supportHref({ source: "복지로" }), active: selectedSource === "복지로" },
  { label: "K-Startup", count: counts.kstartup, href: supportHref({ source: "K-Startup" }), active: selectedSource === "K-Startup" },
  { label: "청년", count: counts.youth, href: supportHref({ q: "청년" }), active: selectedQ === "청년" },
  { label: "소상공인", count: counts.smallBusiness, href: supportHref({ q: "소상공인" }), active: selectedQ === "소상공인" }
];

const topCategories = categoryGroups.slice(0, 7);
const actionKeywords = [
  "근로장려금 신청방법",
  "근로장려금 대상조회",
  "청년월세 지원 대상",
  "국민취업지원제도 신청조건",
  "건강보험 환급금 조회",
  "소상공인 정책자금 신청서류"
];
const intentCards = [
  { title: "지원금 정보", desc: "생활비·복지·청년 지원을 확인", href: supportHref({ q: "지원금" }) },
  { title: "환급금 정보", desc: "환급·장려금처럼 조회가 필요한 정보", href: supportHref({ q: "환급금" }) },
  { title: "대출·정책자금", desc: "소상공인·주거·창업 자금 지원", href: supportHref({ q: "정책자금" }) }
];
---

<BaseLayout
  title="정부지원금 검색 결과 - GovFind"
  description="공식 출처 기준으로 정리된 정부지원금 검색 결과입니다. 자격을 단정하지 않고 조건 확인과 공식 신청처 이동을 돕습니다."
>
  <section class="support-search-head">
    <div class="wrap">
      <p class="eyebrow">내 조건으로 찾기</p>
      <h1>지원금, 환급금, 정책자금을 조건별로 빠르게 비교하세요</h1>
      <p class="lead">GovFind는 공식 출처 기준으로 정보를 정리하고, 자격을 단정하지 않습니다. 대상, 지역, 신청 기간, 필요 서류를 먼저 확인한 뒤 공식 신청처로 이동하세요.</p>

      <div class="support-intent-grid" aria-label="빠른 검색 유형">
        {intentCards.map((item) => (
          <a href={item.href}>
            <strong>{item.title}</strong>
            <span>{item.desc}</span>
          </a>
        ))}
      </div>

      <QuickConditionSearch />

      <form class="support-search-form" action="/support/" method="get">
        <div class="support-search-main">
          <Search size={21} aria-hidden="true" />
          <input name="q" type="search" value={selectedQ} placeholder="근로장려금, 청년월세, 환급금, 소상공인 정책자금 검색" />
          <button class="button" type="submit">검색</button>
        </div>
        <div class="support-search-selects">
          <select class="input" name="category" aria-label="카테고리">
            <option value="">전체 카테고리</option>
            {categories.map((item) => <option value={item} selected={selectedCategory === item}>{item}</option>)}
          </select>
          <select class="input" name="region" aria-label="지역">
            <option value="">전체 지역</option>
            {regions.map((item) => <option value={item} selected={selectedRegion === item}>{item}</option>)}
          </select>
          <select class="input" name="source" aria-label="출처">
            <option value="">전체 출처</option>
            {publicSourceOptions.map((item) => <option value={item.value} selected={selectedSource === item.value}>{item.label}</option>)}
          </select>
        </div>
      </form>

      <nav class="support-tabs" aria-label="빠른 결과 필터">
        {quickTabs.map((tab) => (
          <a class={tab.active ? "active" : ""} href={tab.href}>
            <span>{tab.label}</span>
            <strong>{tab.count.toLocaleString("ko-KR")}</strong>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section tight support-summary-band">
    <div class="wrap support-summary-grid">
      <div><strong>{counts.gov24.toLocaleString("ko-KR")}</strong><span>정부24 혜택</span></div>
      <div><strong>{counts.welfare.toLocaleString("ko-KR")}</strong><span>복지로 정책</span></div>
      <div><strong>{counts.kstartup.toLocaleString("ko-KR")}</strong><span>창업공고</span></div>
      <div><strong>공식</strong><span>신청처 이동</span></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap results-layout support-results-layout">
      <aside class="support-sidebar" aria-label="검색 필터">
        <details class="filter-card card" open>
          <summary><SlidersHorizontal size={18} />상세 필터</summary>
          <label>생애주기
            <select class="input" data-filter="lifeStage">
              <option value="">전체</option>
              {lifeStages.map((item) => <option value={item}>{item}</option>)}
            </select>
          </label>
          <label>모집 상태
            <select class="input" data-filter="status">
              <option value="">전체</option>
              <option selected={selectedStatus === "모집중"}>모집중</option>
              <option selected={selectedStatus === "마감임박"}>마감임박</option>
              <option selected={selectedStatus === "상시"}>상시</option>
              <option selected={selectedStatus === "예정"}>예정</option>
            </select>
          </label>
          <label>출처
            <select class="input" data-filter="source">
              <option value="">전체</option>
              {publicSourceOptions.map((item) => <option value={item.value}>{item.label}</option>)}
            </select>
          </label>
          <label class="check-row">
            <input type="checkbox" data-filter="online" />
            온라인 신청 가능
          </label>
        </details>

        <div class="card support-category-card">
          <h2>분야별 보기</h2>
          <div class="quick-tags">
            {topCategories.map((category) => <a class="chip" href={`/category/${category.slug}/`}>{category.label}</a>)}
          </div>
        </div>

        <div class="card support-source-card">
          <h2><CheckCircle2 size={18} /> 확인 기준</h2>
          <p>GovFind는 공식 출처를 기준으로 조건 확인을 돕고, 자격 판정과 접수는 각 기관 공식 페이지에서 진행됩니다.</p>
        </div>
      </aside>

      <div class="support-result-main">
        <div class="result-head support-result-head">
          <div>
            <p class="eyebrow"><span id="result-count">{publicDisplayPolicies.length}</span>개 결과</p>
            <h2>조건, 기한, 신청처를 빠르게 비교하세요</h2>
            <p class="notice">카드를 열면 지원 대상, 신청 방법, 필요 서류와 공식 신청 링크를 확인할 수 있습니다.</p>
          </div>
          <select class="input small" data-sort aria-label="정렬">
            <option value="recommended">추천순</option>
            <option value="deadline">마감임박순</option>
            <option value="popular">인기순</option>
            <option value="online">온라인 신청 우선</option>
          </select>
        </div>

        <div class="support-keyword-row" aria-label="인기 검색어">
          {actionKeywords.map((keyword) => <a class="chip" href={`/support/?q=${encodeURIComponent(keyword)}`}>{keyword}</a>)}
        </div>

        <div class="result-grid support-result-list">
          {displayPolicies.map((policy) => <PolicyCard policy={policy} />)}
        </div>
        <div class="card no-results" id="noResults" hidden>
          <h2>검색 결과 없음</h2>
          <p>표현을 조금 바꾸거나 아래 추천 키워드로 다시 찾아보세요.</p>
          <div class="quick-tags">
            {actionKeywords.map((keyword) => <a class="chip" href={`/support/?q=${encodeURIComponent(keyword)}`}>{keyword}</a>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section tight dashboard-teaser">
    <div class="wrap split wide">
      <div>
        <p class="eyebrow">공식 신청 전 체크</p>
        <h2>민간 사이트에서 끝내지 말고 공식 원문까지 확인하세요</h2>
        <p class="lead">GovFind는 공식 출처 기준으로 정리된 정부지원금 검색 서비스입니다. 최종 자격 판정과 접수는 정부24, 복지로, 고용24, K-Startup 등 공식 기관에서 진행됩니다.</p>
        <div class="toolbar"><a class="button secondary" href="/sources/">공식 데이터 출처 보기</a></div>
      </div>
      <div class="notification-grid">
        <div><strong>대상 조건</strong><span>나이·소득·지역·가구 기준 확인</span></div>
        <div><strong>신청 기간</strong><span>마감일과 예산 소진 여부 확인</span></div>
        <div><strong>필요 서류</strong><span>계약서·증빙·신분 서류 확인</span></div>
        <div><strong>공식 원문</strong><span>최종 신청은 기관 페이지에서 진행</span></div>
      </div>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    const keyword = params.get("q")?.trim() ?? "";
    const selectedCategory = params.get("category")?.trim() ?? "";
    const selectedRegion = params.get("region")?.trim() ?? "";
    const selectedLife = params.get("lifeStage")?.trim() ?? "";
    const selectedStatus = params.get("status")?.trim() ?? "";
    const selectedSource = normalizeSource(params.get("source")?.trim() ?? "");
    const selectedTarget = params.get("target")?.trim() ?? "";
    const selectedPurpose = params.get("purpose")?.trim() ?? "";
    const selectedOnline = params.get("online") === "true";
    const selectedApplyOnline = params.get("applyOnline") === "true";
    const selectedSort = params.get("sort")?.trim() ?? "recommended";
    const count = document.querySelector("#result-count");
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".support-card"));
    const lifeStage = document.querySelector<HTMLSelectElement>('[data-filter="lifeStage"]');
    const status = document.querySelector<HTMLSelectElement>('[data-filter="status"]');
    const source = document.querySelector<HTMLSelectElement>('[data-filter="source"]');
    const online = document.querySelector<HTMLInputElement>('[data-filter="online"]');
    const sort = document.querySelector<HTMLSelectElement>("[data-sort]");
    const resultGrid = document.querySelector<HTMLElement>(".result-grid");
    const noResults = document.querySelector<HTMLElement>("#noResults");
    const topCategory = document.querySelector<HTMLSelectElement>('.support-search-selects select[name="category"]');
    const topRegion = document.querySelector<HTMLSelectElement>('.support-search-selects select[name="region"]');
    const topSource = document.querySelector<HTMLSelectElement>('.support-search-selects select[name="source"]');
    const searchInput = document.querySelector<HTMLInputElement>('.support-search-main input[name="q"]');
    const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>(".support-tabs a"));
    const conditionChips = Array.from(document.querySelectorAll<HTMLButtonElement>(".condition-chip"));
    const conditionSubmit = document.querySelector<HTMLButtonElement>("#conditionSubmit");
    const stopWords = new Set(["신청", "신청방법", "방법", "대상", "대상조회", "조회", "지원", "조건", "서류", "신청서류", "확인", "보기", "정보"]);

    function normalizeSource(value: string) {
      if (value.includes("정부24")) return "정부24";
      if (value.includes("복지로")) return "복지로";
      if (value.includes("K-Startup")) return "K-Startup";
      return value.replace(/\s*API\b/g, "").replace("공공서비스", "").trim();
    }

    function normalizeSearch(value: string) {
      return value.toLowerCase().replace(/[·ㆍ・]/g, "").replace(/[^\p{L}\p{N}]+/gu, "");
    }

    function queryTokens(value: string) {
      return value
        .split(/\s+/)
        .map((item) => item.trim())
        .filter((item) => item.length > 1);
    }

    function meaningfulTokens(value: string) {
      return queryTokens(value).filter((item) => !stopWords.has(item));
    }

    function cardQueryScore(card: HTMLElement) {
      if (!keyword) return Number(card.dataset.score ?? 0);
      const title = normalizeSearch(card.dataset.title ?? "");
      const tags = normalizeSearch(card.dataset.tags ?? "");
      const docs = normalizeSearch(card.dataset.documents ?? "");
      const text = normalizeSearch(card.dataset.search ?? "");
      const query = normalizeSearch(keyword);
      const tokens = meaningfulTokens(keyword);
      const hasMeaningfulMatch = tokens.length === 0 || tokens.some((token) => text.includes(normalizeSearch(token)));
      if (!hasMeaningfulMatch) return 0;

      let score = 0;
      if (title.includes(query)) score += 120;
      if (tags.includes(query)) score += 80;
      if (text.includes(query)) score += 60;
      for (const token of tokens) {
        const normalized = normalizeSearch(token);
        if (title.includes(normalized)) score += 45;
        else if (tags.includes(normalized)) score += 32;
        else if (text.includes(normalized)) score += 14;
      }
      if (keyword.includes("서류") && docs) score += 10;
      if (keyword.includes("신청") && text.includes("신청")) score += 8;
      if (keyword.includes("조회") && text.includes("조회")) score += 12;
      if (keyword.includes("환급") && text.includes("환급")) score += 18;
      return score;
    }

    function conditionText(value: string) {
      if (value === "부모/육아") return "부모 육아 출산 보육 아동";
      if (value === "농어업인") return "농업인 어업인 농림어업 영농 어촌";
      if (value === "현금지원") return "장려금 지원금 수당 급여 현금";
      if (value === "주거·월세") return "주거 월세 전세 임차";
      if (value === "취업·교육") return "취업 구직 교육 훈련";
      if (value === "창업·사업자금") return "창업 사업화 사업자금";
      if (value === "대출·정책자금") return "대출 정책자금 융자 자금";
      return value;
    }

    function conditionMatches(card: HTMLElement, value: string) {
      if (!value) return true;
      const text = normalizeSearch(card.dataset.search ?? "");
      return conditionText(value).split(/\s+/).some((token) => text.includes(normalizeSearch(token)));
    }

    if (lifeStage) lifeStage.value = selectedLife;
    if (status) status.value = selectedStatus;
    if (source) source.value = selectedSource;
    if (online) online.checked = selectedOnline;
    if (sort) sort.value = selectedSort;
    if (topCategory) topCategory.value = selectedCategory;
    if (topRegion) topRegion.value = selectedRegion;
    if (topSource) topSource.value = selectedSource;
    if (searchInput) searchInput.value = keyword;
    for (const chip of conditionChips) {
      const key = chip.dataset.conditionKey;
      const value = chip.dataset.conditionValue;
      const active =
        (key === "target" && value === selectedTarget) ||
        (key === "purpose" && value === selectedPurpose) ||
        (key === "region" && value === selectedRegion) ||
        (key === "apply" && ((value === "온라인 가능" && selectedApplyOnline) || (value === "마감임박" && selectedStatus === "마감임박") || (value === "상시신청" && selectedStatus === "상시")));
      chip.classList.toggle("active", active);
    }

    function querySignature(search: string) {
      const values = new URLSearchParams(search);
      const entries = Array.from(values.entries()).filter(([key]) => ["q", "category", "region", "source", "status"].includes(key));
      return entries.sort(([a], [b]) => a.localeCompare(b)).map(([key, value]) => `${key}=${value}`).join("&");
    }

    function syncActiveTabs() {
      const current = querySignature(window.location.search);
      for (const tab of tabs) {
        const tabUrl = new URL(tab.href);
        tab.classList.toggle("active", querySignature(tabUrl.search) === current);
      }
    }

    function ddayRank(value: string) {
      if (value === "D-Day") return 0;
      if (value.startsWith("D-")) return Number(value.replace("D-", "")) || 999;
      if (value === "상시") return 500;
      if (value === "예정") return 700;
      return 999;
    }

    function syncUrl() {
      const next = new URLSearchParams();
      if (keyword) next.set("q", keyword);
      if (selectedCategory) next.set("category", selectedCategory);
      if (selectedRegion) next.set("region", selectedRegion);
      if (selectedTarget) next.set("target", selectedTarget);
      if (selectedPurpose) next.set("purpose", selectedPurpose);
      if (lifeStage?.value) next.set("lifeStage", lifeStage.value);
      if (status?.value) next.set("status", status.value);
      if (source?.value) next.set("source", source.value);
      if (online?.checked) next.set("online", "true");
      if (selectedApplyOnline) next.set("applyOnline", "true");
      if (sort?.value && sort.value !== "recommended") next.set("sort", sort.value);
      const query = next.toString();
      window.history.replaceState(null, "", query ? `/support/?${query}` : "/support/");
    }

    function sortCards() {
      if (!resultGrid || !sort) return;
      const sorted = [...cards].sort((a, b) => {
        const scoreDiff = cardQueryScore(b) - cardQueryScore(a);
        if (keyword && scoreDiff !== 0) return scoreDiff;
        if (sort.value === "deadline") return ddayRank(a.dataset.dday ?? "") - ddayRank(b.dataset.dday ?? "");
        if (sort.value === "popular") return Number(b.dataset.views ?? 0) - Number(a.dataset.views ?? 0);
        if (sort.value === "online") return Number(b.dataset.online === "true") - Number(a.dataset.online === "true");
        return Number(b.dataset.score ?? 0) - Number(a.dataset.score ?? 0);
      });
      for (const card of sorted) resultGrid.appendChild(card);
    }

    function applyFilters() {
      const lifeValue = lifeStage?.value ?? "";
      const statusValue = status?.value ?? "";
      const sourceValue = source?.value ?? "";
      const onlineOnly = online?.checked ?? false;
      let visible = 0;

      for (const card of cards) {
        const text = card.dataset.search ?? "";
        const cardCategory = card.dataset.category ?? "";
        const cardRegion = card.dataset.region ?? "";
        const cardStatus = card.dataset.status ?? "";
        const cardSource = card.dataset.source ?? "";
        const cardSourceLabel = card.dataset.sourceLabel ?? "";
        const cardOnline = card.dataset.online === "true";
        const searchOnly = card.dataset.searchOnly === "true";
        const queryScore = cardQueryScore(card);
        card.dataset.queryScore = String(queryScore);
        const matchKeyword = !keyword || queryScore > 0;
        const matchCategory = !selectedCategory || cardCategory === selectedCategory;
        const matchRegion = !selectedRegion || cardRegion === selectedRegion || cardRegion === "전국" || cardRegion === "지역별";
        const matchLife = !lifeValue || text.includes(lifeValue);
        const matchStatus = !statusValue || cardStatus === statusValue;
        const matchSource = !sourceValue || cardSource === sourceValue || cardSourceLabel === sourceValue;
        const matchOnline = (!onlineOnly && !selectedApplyOnline) || cardOnline;
        const matchTarget = conditionMatches(card, selectedTarget);
        const matchPurpose = conditionMatches(card, selectedPurpose);
        const matchSearchOnly = !searchOnly || Boolean(keyword);
        const isVisible = matchSearchOnly && matchKeyword && matchCategory && matchRegion && matchLife && matchStatus && matchSource && matchOnline && matchTarget && matchPurpose;
        card.hidden = !isVisible;
        card.style.display = isVisible ? "" : "none";
        if (isVisible) visible += 1;
      }

      if (count) count.textContent = String(visible);
      if (noResults) noResults.hidden = visible > 0;
      sortCards();
      syncUrl();
      syncActiveTabs();
    }

    conditionChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const key = chip.dataset.conditionKey;
        const group = chip.closest("[data-condition-group]");
        const wasActive = chip.classList.contains("active");
        group?.querySelectorAll(".condition-chip").forEach((item) => item.classList.remove("active"));
        if (!wasActive) chip.classList.add("active");
        if (key === "region" && topRegion) topRegion.value = chip.classList.contains("active") ? chip.dataset.conditionValue ?? "" : "";
      });
    });

    conditionSubmit?.addEventListener("click", () => {
      const next = new URLSearchParams();
      for (const chip of conditionChips.filter((item) => item.classList.contains("active"))) {
        const key = chip.dataset.conditionKey;
        const value = chip.dataset.conditionValue ?? "";
        if (key === "apply" && value === "온라인 가능") next.set("applyOnline", "true");
        else if (key === "apply" && value === "마감임박") next.set("status", "마감임박");
        else if (key === "apply" && value === "상시신청") next.set("status", "상시");
        else if (key && value) next.set(key, value);
      }
      window.location.href = `/support/${next.toString() ? `?${next.toString()}` : ""}`;
    });

    lifeStage?.addEventListener("change", applyFilters);
    status?.addEventListener("change", applyFilters);
    source?.addEventListener("change", applyFilters);
    online?.addEventListener("change", applyFilters);
    sort?.addEventListener("change", applyFilters);
    applyFilters();
  </script>
</BaseLayout>
