---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PolicyCard from "../../components/PolicyCard.astro";
import { Search } from "@lucide/astro";
import { policies, categories } from "../../data/policies";

const q = "";
const category = "";
const filtered = policies;
---

<BaseLayout title="정부지원금 찾기 - GovFind" description="청년, 소상공인, 주거, 복지, 창업 지원금을 조건별로 검색하고 비교하세요.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">지원금 찾기</p>
      <h1>조건에 맞는 지원금을 검색하세요</h1>
      <form class="toolbar" action="/support/" method="get">
        <input class="input" name="q" value={q} type="search" placeholder="검색어를 입력하세요" style="max-width: 420px;" />
        <button class="button" type="submit"><Search size={18} />검색</button>
      </form>
      <div class="toolbar">
        <a class="chip" href="/support/">전체</a>
        {categories.map((item) => <a class="chip" href={`/support/?category=${encodeURIComponent(item)}`}>{item}</a>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow"><span id="result-count">{filtered.length}</span>개 결과</p>
      <div class="grid cols-3">
        {filtered.map((policy) => <PolicyCard policy={policy} />)}
      </div>
    </div>
  </section>
  <script>
    const params = new URLSearchParams(window.location.search);
    const keyword = params.get("q")?.trim() ?? "";
    const selectedCategory = params.get("category")?.trim() ?? "";
    const input = document.querySelector<HTMLInputElement>('input[name="q"]');
    const count = document.querySelector("#result-count");
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".support-card"));

    if (input) input.value = keyword;

    let visible = 0;
    for (const card of cards) {
      const text = card.dataset.search ?? "";
      const cardCategory = card.dataset.category ?? "";
      const matchKeyword = !keyword || text.includes(keyword);
      const matchCategory = !selectedCategory || cardCategory === selectedCategory;
      const isVisible = matchKeyword && matchCategory;
      card.style.display = isVisible ? "" : "none";
      if (isVisible) visible += 1;
    }

    if (count) count.textContent = String(visible);
  </script>
</BaseLayout>
