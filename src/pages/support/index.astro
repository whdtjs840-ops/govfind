---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PolicyCard from "../../components/PolicyCard.astro";
import QuickConditionSearch from "../../components/QuickConditionSearch.astro";
import { CheckCircle2, Search, SlidersHorizontal } from "@lucide/astro";
import { categories, categoryGroups, lifeStages, policies, regions } from "../../data/policies";
import { derivePolicyTags, supportedPolicyTags } from "../../utils/derivedTags";
import { publicSourceOptions, sourceLabel } from "../../utils/sourceNames";
import {
  cleanSummary,
  deadlineDisplay,
  filterPolicies,
  getDisplayRegion,
  getDisplayStatus,
  getPolicyCounts,
  getPublicPolicies,
  isDeadlineSoonPolicy,
  isSearchOnlyPolicy,
  policySearchText,
  shouldIncludeInDeadlineSort,
  shouldIncludeInRegionPage,
  shouldIncludeInStatusFilter,
  shouldRequireOfficialConfirmation,
  shouldShowDday,
  sortPolicies,
  type PolicySort
} from "../../utils/policyUtils";

const publicDisplayPolicies = getPublicPolicies(policies);
const policyCounts = getPolicyCounts(policies);
const publicPolicyCountLabel = policyCounts.all.toLocaleString("ko-KR");

const params = Astro.url.searchParams;
const selectedQ = params.get("q") ?? "";
const selectedCategory = params.get("category") ?? "";
const selectedRegion = params.get("region") ?? "";
const selectedSource = sourceLabel(params.get("source") ?? "");
const selectedStatus = params.get("status") ?? "";
const selectedLife = params.get("lifeStage") ?? "";
const selectedTag = params.get("tag") ?? "";
const selectedOnline = params.get("online") === "true";
const selectedApplyOnline = params.get("applyOnline") === "true";
const selectedSort = (params.get("sort") ?? "recommended") as PolicySort;
const supportPageSize = 30;

function conditionText(value: string) {
  return value;
}
function matchesCondition(policy: (typeof publicDisplayPolicies)[number], value: string) {
  if (!value) return true;
  const text = `${policy.title} ${policy.category} ${policy.source} ${policy.agency} ${policy.lifeStage} ${policy.targetGroup} ${policy.summary} ${policy.audience} ${policy.apply} ${policy.amount} ${policy.documents.join(" ")} ${policy.benefits.join(" ")} ${policy.tags.join(" ")}`.toLowerCase();
  return conditionText(value).split(/\s+/).filter(Boolean).some((token) => text.includes(token.toLowerCase()));
}

const selectedProfile = params.get("profile") ?? "";
const selectedTarget = params.get("target") ?? "";
const selectedPurpose = params.get("purpose") ?? "";
const filteredPolicies = sortPolicies(
  filterPolicies(publicDisplayPolicies, {
    q: selectedQ,
    category: selectedCategory,
    region: selectedRegion,
    source: selectedSource,
    status: selectedStatus,
    online: selectedOnline || selectedApplyOnline
  }).filter((policy) => (
    (!selectedLife || `${policy.lifeStage} ${policy.tags.join(" ")}`.includes(selectedLife)) &&
    (!selectedTag || derivePolicyTags(policy).includes(selectedTag)) &&
    matchesCondition(policy, selectedProfile) &&
    matchesCondition(policy, selectedTarget) &&
    matchesCondition(policy, selectedPurpose)
  )),
  selectedSort
);
const totalResults = filteredPolicies.length;
const totalPages = Math.max(1, Math.ceil(totalResults / supportPageSize));
const requestedPage = Number.parseInt(params.get("page") ?? "1", 10);
const currentPage = Math.min(Math.max(Number.isFinite(requestedPage) ? requestedPage : 1, 1), totalPages);
const pageStartIndex = totalResults === 0 ? 0 : (currentPage - 1) * supportPageSize + 1;
const pageEndIndex = Math.min(currentPage * supportPageSize, totalResults);
const pagePolicies = filteredPolicies.slice((currentPage - 1) * supportPageSize, currentPage * supportPageSize);
const counts = {
  all: policyCounts.all,
  deadline: policyCounts.deadline,
  gov24: policyCounts.bySource["정부24"] ?? 0,
  welfare: policyCounts.bySource["복지로"] ?? 0,
  bizinfo: policyCounts.bySource["기업마당"] ?? 0,
  ontongYouth: policyCounts.bySource["온통청년"] ?? 0,
  kstartup: policyCounts.bySource["K-Startup"] ?? 0,
  youth: publicDisplayPolicies.filter((policy) => `${policy.title} ${policy.tags.join(" ")}`.includes("청년")).length,
  smallBusiness: publicDisplayPolicies.filter((policy) => `${policy.title} ${policy.tags.join(" ")}`.includes("소상공인")).length
};
const activeCategories = categories.filter((category) => (policyCounts.byCategory[category] ?? 0) > 0);

function supportUrl(query: URLSearchParams) {
  const value = query.toString();
  return value ? `/support/?${value}` : "/support/";
}

function supportHref(next: Record<string, string | boolean | number | null | undefined>, preserve = false) {
  const query = preserve ? new URLSearchParams(params) : new URLSearchParams();
  query.delete("page");
  for (const [key, value] of Object.entries(next)) {
    if (value === undefined || value === null || value === "" || value === false) query.delete(key);
    else query.set(key, String(value));
  }
  return supportUrl(query);
}

function supportPageHref(page: number) {
  const query = new URLSearchParams(params);
  if (page <= 1) query.delete("page");
  else query.set("page", String(page));
  return supportUrl(query);
}

function withoutParams(keys: string[]) {
  const query = new URLSearchParams(params);
  query.delete("page");
  for (const key of keys) query.delete(key);
  return supportUrl(query);
}

function paginationItems(current: number, total: number) {
  if (total <= 7) return Array.from({ length: total }, (_, index) => index + 1);
  const pages = new Set([1, total]);
  for (let page = current - 2; page <= current + 2; page += 1) {
    if (page > 1 && page < total) pages.add(page);
  }
  const sorted = [...pages].sort((a, b) => a - b);
  const items: (number | "ellipsis")[] = [];
  for (const page of sorted) {
    const previous = items[items.length - 1];
    if (typeof previous === "number" && page - previous > 1) items.push("ellipsis");
    items.push(page);
  }
  return items;
}

const activeFilters = [
  selectedQ ? { label: `검색어: ${selectedQ}`, href: withoutParams(["q"]) } : null,
  selectedCategory ? { label: `카테고리: ${selectedCategory}`, href: withoutParams(["category"]) } : null,
  selectedRegion ? { label: `지역: ${selectedRegion}`, href: withoutParams(["region"]) } : null,
  selectedStatus ? { label: `상태: ${selectedStatus}`, href: withoutParams(["status"]) } : null,
  selectedSource ? { label: `출처: ${selectedSource}`, href: withoutParams(["source"]) } : null,
  selectedLife ? { label: `생애주기: ${selectedLife}`, href: withoutParams(["lifeStage"]) } : null,
  selectedProfile ? { label: `대상: ${selectedProfile}`, href: withoutParams(["profile"]) } : null,
  selectedTarget ? { label: `대상: ${selectedTarget}`, href: withoutParams(["target"]) } : null,
  selectedPurpose ? { label: `목적: ${selectedPurpose}`, href: withoutParams(["purpose"]) } : null,
  selectedOnline || selectedApplyOnline ? { label: "온라인 신청 가능", href: withoutParams(["online", "applyOnline"]) } : null
].filter(Boolean) as { label: string; href: string }[];

const resultCountLabel = totalResults.toLocaleString("ko-KR");
const resultSummaryTitle = selectedQ && selectedCategory
  ? `‘${selectedQ}’ 검색 결과 · ${selectedCategory} 필터 적용 · ${resultCountLabel}개`
  : selectedQ
    ? `‘${selectedQ}’ 검색 결과 ${resultCountLabel}개`
    : selectedCategory
      ? `${selectedCategory} 카테고리 지원사업 ${resultCountLabel}개`
      : activeFilters.length > 0
        ? `${activeFilters.map((item) => item.label).join(" · ")} · ${resultCountLabel}개`
        : `전체 지원사업 ${resultCountLabel}개`;
const resultSummaryDetail = activeFilters.length > 0
  ? `적용된 조건: ${activeFilters.map((item) => item.label).join(" · ")}`
  : "카드를 열면 지원 대상, 신청 방법, 필요 서류와 공식 신청 링크를 확인할 수 있습니다.";
const resultRangeLabel = totalResults === 0
  ? "0개 표시"
  : `${pageStartIndex.toLocaleString("ko-KR")}–${pageEndIndex.toLocaleString("ko-KR")}개 표시`;
const paginationPages = paginationItems(currentPage, totalPages);

const quickTabs = [
  { label: "전체", count: counts.all, href: supportHref({}), active: !selectedQ && !selectedCategory && !selectedSource && !selectedStatus },
  { label: "마감임박", count: counts.deadline, href: supportHref({ status: "마감임박" }), active: selectedStatus === "마감임박" },
  { label: "정부24", count: counts.gov24, href: supportHref({ source: "정부24" }), active: selectedSource === "정부24" },
  { label: "복지로", count: counts.welfare, href: supportHref({ source: "복지로" }), active: selectedSource === "복지로" },
  { label: "기업마당", count: counts.bizinfo, href: supportHref({ source: "기업마당" }), active: selectedSource === "기업마당" },
  { label: "온통청년", count: counts.ontongYouth, href: supportHref({ source: "온통청년" }), active: selectedSource === "온통청년" },
  { label: "K-Startup", count: counts.kstartup, href: supportHref({ source: "K-Startup" }), active: selectedSource === "K-Startup" },
  { label: "청년", count: counts.youth, href: supportHref({ q: "청년" }), active: selectedQ === "청년" },
  { label: "소상공인", count: counts.smallBusiness, href: supportHref({ q: "소상공인" }), active: selectedQ === "소상공인" }
];

const topCategories = categoryGroups.filter((category) => (policyCounts.byCategory[category.label] ?? 0) > 0).slice(0, 7);
const primaryTags = ["정책자금", "창업", "사업화", "기술지원", "수출", "소상공인", "청년취업", "청년주거", "긴급복지"];
const tagCounts = Object.fromEntries(
  supportedPolicyTags.map((tag) => [
    tag,
    publicDisplayPolicies.filter((policy) => derivePolicyTags(policy).includes(tag)).length
  ])
) as Record<string, number>;
const suggestedTagsByQuery = [
  { terms: ["\uCC3D\uC5C5", "\uC2A4\uD0C0\uD2B8\uC5C5", "\uC608\uBE44\uCC3D\uC5C5", "\uCD08\uAE30\uCC3D\uC5C5"], tags: ["\uC608\uBE44\uCC3D\uC5C5", "\uCD08\uAE30\uCC3D\uC5C5", "\uC0AC\uC5C5\uD654", "\uD22C\uC790", "\uACBD\uC601"] },
  { terms: ["\uC18C\uC0C1\uACF5\uC778", "\uC911\uC18C\uAE30\uC5C5", "\uAE30\uC5C5"], tags: ["\uC815\uCC45\uC790\uAE08", "\uACBD\uC601", "\uD310\uB85C", "\uAE30\uC220\uC9C0\uC6D0", "\uC778\uC99D"] },
  { terms: ["\uCCAD\uB144"], tags: ["\uCCAD\uB144\uCDE8\uC5C5", "\uCCAD\uB144\uC8FC\uAC70", "\uCCAD\uB144\uCC3D\uC5C5", "\uCCAD\uB144\uAD50\uC721"] },
  { terms: ["\uBCF5\uC9C0", "\uAE34\uAE09\uBCF5\uC9C0"], tags: ["\uAE34\uAE09\uBCF5\uC9C0", "\uC0DD\uACC4", "\uC758\uB8CC", "\uC8FC\uAC70\uAE09\uC5EC"] },
  { terms: ["\uB18D\uC5C5", "\uB18D\uAE30\uACC4", "\uB18D\uB9BC\uC5B4\uC5C5"], tags: ["\uB18D\uAE30\uACC4", "\uC601\uB18D", "\uADC0\uB18D", "\uCD95\uC0B0"] },
  { terms: ["\uC218\uCD9C", "\uD574\uC678"], tags: ["\uC218\uCD9C", "\uD310\uB85C", "\uB9C8\uCF00\uD305"] },
  { terms: ["\uAE30\uC220\uC9C0\uC6D0", "\uAE30\uC220", "r&d", "rd"], tags: ["\uAE30\uC220\uC9C0\uC6D0", "\uC778\uC99D", "\uC0AC\uC5C5\uD654"] }
];
const suggestedSearchTags = totalResults > 0 && selectedQ
  ? suggestedTagsByQuery
    .filter((group) => group.terms.some((term) => selectedQ.toLowerCase().includes(term.toLowerCase())))
    .flatMap((group) => group.tags)
    .filter((tag, index, list) => list.indexOf(tag) === index && tag !== selectedTag && (tagCounts[tag] ?? 0) > 0)
    .slice(0, 8)
  : [];
const actionKeywords = [
  "근로장려금 신청방법",
  "근로장려금 대상조회",
  "청년월세 지원 대상",
  "국민취업지원제도 신청조건",
  "건강보험 환급금 조회",
  "소상공인 정책자금 신청서류"
];
const intentCards = [
  { title: "지원금 정보", desc: "생활비·복지·청년 지원을 확인", href: supportHref({ q: "지원금" }) },
  { title: "환급금 정보", desc: "환급·장려금처럼 조회가 필요한 정보", href: supportHref({ q: "환급금" }) },
  { title: "대출·정책자금", desc: "소상공인·주거·창업 자금 지원", href: supportHref({ q: "정책자금" }) }
];
---

<BaseLayout
  title="정부지원금 검색 결과 - GovFind"
  description="공식 출처 기준으로 정리된 정부지원금 검색 결과입니다. 자격을 단정하지 않고 조건 확인과 공식 신청처 이동을 돕습니다."
>
  <section class="support-search-head">
    <div class="wrap">
      <p class="eyebrow">내 조건으로 찾기</p>
      <h1>지원금, 환급금, 정책자금을 조건별로 빠르게 비교하세요</h1>
      <p class="lead">현재 공개 중인 지원사업 {publicPolicyCountLabel}개를 만료 공고 제외 기준으로 검색합니다. 카테고리, 태그, 출처를 조합해 지금 확인할 수 있는 정책만 빠르게 좁혀보세요.</p>

      <div class="support-intent-grid" aria-label="빠른 검색 유형">
        {intentCards.map((item) => (
          <a href={item.href}>
            <strong>{item.title}</strong>
            <span>{item.desc}</span>
          </a>
        ))}
      </div>

      <QuickConditionSearch />

      <form class="support-search-form" action="/support/" method="get">
        {selectedTag && <input type="hidden" name="tag" value={selectedTag} />}
        <div class="support-search-main">
          <Search size={21} aria-hidden="true" />
          <input name="q" type="search" value={selectedQ} placeholder="근로장려금, 청년월세, 환급금, 소상공인 정책자금 검색" />
          <button class="button" type="submit">검색</button>
        </div>
        <div class="support-search-selects">
          <select class="input" name="category" aria-label="카테고리">
            <option value="">전체 카테고리</option>
            {activeCategories.map((item) => <option value={item} selected={selectedCategory === item}>{item}</option>)}
          </select>
          <select class="input" name="region" aria-label="지역">
            <option value="">전체 지역</option>
            {regions.map((item) => <option value={item} selected={selectedRegion === item}>{item}</option>)}
          </select>
          <select class="input" name="source" aria-label="출처">
            <option value="">전체 출처</option>
            {publicSourceOptions.map((item) => <option value={item.value} selected={selectedSource === item.value}>{item.label}</option>)}
          </select>
        </div>
      </form>

      <nav class="support-tabs" aria-label="빠른 결과 필터">
        {quickTabs.map((tab) => (
          <a class={tab.active ? "active" : ""} href={tab.href}>
            <span>{tab.label}</span>
            <strong>{tab.count.toLocaleString("ko-KR")}</strong>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section tight support-summary-band">
      <div class="wrap support-summary-grid">
        <div><strong>{counts.gov24.toLocaleString("ko-KR")}</strong><span>정부24 혜택</span></div>
        <div><strong>{counts.welfare.toLocaleString("ko-KR")}</strong><span>복지로 정책</span></div>
        <div><strong>{counts.bizinfo.toLocaleString("ko-KR")}</strong><span>기업마당 공고</span></div>
        <div><strong>{counts.ontongYouth.toLocaleString("ko-KR")}</strong><span>온통청년 정책</span></div>
      </div>
  </section>

  <section class="section">
    <div class="wrap results-layout support-results-layout">
      <aside class="support-sidebar" aria-label="검색 필터">
        <details class="filter-card card" open>
          <summary><SlidersHorizontal size={18} />상세 필터</summary>
          <label>생애주기
            <select class="input" data-filter="lifeStage">
              <option value="">전체</option>
              {lifeStages.map((item) => <option value={item} selected={selectedLife === item}>{item}</option>)}
            </select>
          </label>
          <label>모집 상태
            <select class="input" data-filter="status">
              <option value="">전체</option>
              <option selected={selectedStatus === "모집중"}>모집중</option>
              <option selected={selectedStatus === "마감임박"}>마감임박</option>
              <option selected={selectedStatus === "상시"}>상시</option>
              <option selected={selectedStatus === "예정"}>예정</option>
            </select>
          </label>
          <label>출처
            <select class="input" data-filter="source">
              <option value="">전체</option>
              {publicSourceOptions.map((item) => <option value={item.value} selected={selectedSource === item.value}>{item.label}</option>)}
            </select>
          </label>
          <label class="check-row">
            <input type="checkbox" data-filter="online" checked={selectedOnline || selectedApplyOnline} />
            온라인 신청 가능
          </label>
        </details>

        <div class="card support-category-card">
          <h2>분야별 보기</h2>
          <div class="quick-tags">
            {topCategories.map((category) => <a class="chip" href={`/category/${category.slug}/`}>{category.label}</a>)}
          </div>
        </div>

        <div class="card support-source-card">
          <h2><CheckCircle2 size={18} /> 확인 기준</h2>
          <p>GovFind는 공식 출처를 기준으로 조건 확인을 돕고, 자격 판정과 접수는 각 기관 공식 페이지에서 진행됩니다.</p>
        </div>
      </aside>

      <div class="support-result-main">
        <div class="result-head support-result-head">
          <div>
            <p class="eyebrow"><span id="result-count">{totalResults.toLocaleString("ko-KR")}</span>개 결과</p>
            <h2 id="result-summary-title">{resultSummaryTitle}</h2>
            <p class="notice" id="result-summary-detail">{resultSummaryDetail}</p>
            <div class="active-filter-chips" id="activeFilterChips" aria-label="적용된 검색 조건" hidden={activeFilters.length === 0}>
              {activeFilters.map((filter) => (
                <a class="active-filter-chip" href={filter.href} aria-label={`${filter.label} 조건 제거`}>
                  {filter.label} ×
                </a>
              ))}
            </div>
          </div>
          <select class="input small" data-sort aria-label="정렬">
            <option value="recommended" selected={selectedSort === "recommended"}>추천순</option>
            <option value="deadline" selected={selectedSort === "deadline"}>마감임박순</option>
            <option value="popular" selected={selectedSort === "popular"}>인기순</option>
            <option value="online" selected={selectedSort === "online"}>온라인 신청 우선</option>
            <option value="updated" selected={selectedSort === "updated"}>최근 업데이트순</option>
          </select>
        </div>

        <div class="support-keyword-row" aria-label="인기 검색어">
          {actionKeywords.map((keyword) => <a class="chip" href={`/support/?q=${encodeURIComponent(keyword)}`}>{keyword}</a>)}
        </div>

        <div class="support-suggested-tags" data-suggested-tags hidden={suggestedSearchTags.length === 0}>
          <span>관련 태그</span>
          <div class="support-keyword-row">
            {suggestedSearchTags.map((tag) => (
              <a class="chip" href={supportHref({ tag }, true)}>
                {tag}
                <span>{tagCounts[tag].toLocaleString("ko-KR")}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="support-keyword-row support-tag-row" aria-label="세부 태그">
          {primaryTags.filter((tag) => (tagCounts[tag] ?? 0) > 0).map((tag) => (
            <a class={`chip ${selectedTag === tag ? "active" : ""}`} href={supportHref({ tag }, true)}>
              {tag}
              <span>{tagCounts[tag].toLocaleString("ko-KR")}</span>
            </a>
          ))}
        </div>

        <div class="support-result-progress" aria-live="polite">
          <strong>{resultRangeLabel}</strong>
          <span>/</span>
          <span>총 {totalResults.toLocaleString("ko-KR")}개</span>
        </div>

        <div class="result-grid support-result-list">
          {pagePolicies.map((policy) => <PolicyCard policy={policy} />)}
        </div>

        {totalResults > supportPageSize && (
          <nav class="support-pagination" aria-label="지원사업 페이지">
            <a
              class={`page-control ${currentPage === 1 ? "disabled" : ""}`}
              href={currentPage === 1 ? supportPageHref(1) : supportPageHref(currentPage - 1)}
              aria-disabled={currentPage === 1 ? "true" : "false"}
            >
              이전
            </a>
            {paginationPages.map((item) => item === "ellipsis" ? (
              <span class="page-ellipsis" aria-hidden="true">...</span>
            ) : (
              <a
                class={`page-number ${item === currentPage ? "active" : ""}`}
                href={supportPageHref(item)}
                aria-current={item === currentPage ? "page" : undefined}
              >
                {item}
              </a>
            ))}
            <a
              class={`page-control ${currentPage === totalPages ? "disabled" : ""}`}
              href={currentPage === totalPages ? supportPageHref(totalPages) : supportPageHref(currentPage + 1)}
