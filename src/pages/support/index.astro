    function renderPagination(totalPages, currentPage, total) { if (!pagination) return; if (total <= pageSize) { pagination.hidden = true; pagination.innerHTML = ''; return; } pagination.hidden = false; const previous = '<a class="page-control ' + (currentPage === 1 ? 'disabled' : '') + '" href="' + escapeHtml(currentPage === 1 ? pageHref(1) : pageHref(currentPage - 1)) + '" aria-disabled="' + (currentPage === 1 ? 'true' : 'false') + '">' + labels.previous + '</a>'; const next = '<a class="page-control ' + (currentPage === totalPages ? 'disabled' : '') + '" href="' + escapeHtml(currentPage === totalPages ? pageHref(totalPages) : pageHref(currentPage + 1)) + '" aria-disabled="' + (currentPage === totalPages ? 'true' : 'false') + '">' + labels.next + '</a>'; const pages = paginationItems(currentPage, totalPages).map((item) => item === 'ellipsis' ? '<span class="page-ellipsis" aria-hidden="true">...</span>' : '<a class="page-number ' + (item === currentPage ? 'active' : '') + '" href="' + escapeHtml(pageHref(item)) + '" ' + (item === currentPage ? 'aria-current="page"' : '') + '>' + item + '</a>').join(''); pagination.innerHTML = previous + pages + next; }
    function syncTagChips(state) { document.querySelectorAll('.support-tag-row .chip').forEach((chip) => { const tag = new URL(chip.href, window.location.href).searchParams.get('tag') || ''; chip.classList.toggle('active', Boolean(state.tag && tag === state.tag)); }); }
    function renderSuggestedTags(state, total, items) { if (!suggestedTagBox) return; if (!state.keyword || total === 0) { suggestedTagBox.hidden = true; suggestedTagBox.innerHTML = ''; return; } const query = normalizeSearch(state.keyword); const tagCounts = new Map(); for (const policy of items) for (const tag of policy.tags || []) tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1); const tags = suggestedTagsByQuery.filter((group) => group.terms.some((term) => query.includes(normalizeSearch(term)))).flatMap((group) => group.tags).filter((tag, index, list) => list.indexOf(tag) === index && tag !== state.tag && (tagCounts.get(tag) || 0) > 0).slice(0, 8); if (tags.length === 0) { suggestedTagBox.hidden = true; suggestedTagBox.innerHTML = ''; return; } suggestedTagBox.hidden = false; suggestedTagBox.innerHTML = '<span>\uAD00\uB828 \uD0DC\uADF8</span><div class="support-keyword-row">' + tags.map((tag) => '<a class="chip" href="' + escapeHtml(tagHref(tag)) + '">' + escapeHtml(tag) + '<span>' + formatCount(tagCounts.get(tag) || 0) + '</span></a>').join('') + '</div>'; }
    async function renderSupportResultsFromIndex() { const response = await fetch('/search-index.json'); if (!response.ok) throw new Error('search-index fetch failed'); const index = await response.json(); const state = readState(); const matched = filterAndSortPolicies(index.items || [], state); const total = matched.length; const totalPages = Math.max(1, Math.ceil(total / pageSize)); const currentPage = Math.min(state.page, totalPages); const startIndex = total === 0 ? 0 : (currentPage - 1) * pageSize + 1; const endIndex = Math.min(currentPage * pageSize, total); const pageItems = matched.slice((currentPage - 1) * pageSize, currentPage * pageSize); if (resultGrid) resultGrid.innerHTML = pageItems.map(renderCard).join(''); if (noResults) noResults.hidden = total > 0; syncTagChips(state); renderSuggestedTags(state, total, matched); renderSummary(state, total, startIndex, endIndex); renderPagination(totalPages, currentPage, total); }
    function setParamAndNavigate(key, value) { const next = currentParams(); next.delete('page'); if (value === true) next.set(key, 'true'); else if (value) next.set(key, String(value)); else next.delete(key); window.location.href = supportUrl(next, true); }
    searchForms.forEach((form) => { form.addEventListener('submit', (event) => { event.preventDefault(); const next = new URLSearchParams(new FormData(form)); for (const [key, value] of Array.from(next.entries())) if (!String(value).trim()) next.delete(key); window.location.href = supportUrl(next, true); }); });
    filterControls.forEach((control) => { control.addEventListener('change', () => { const key = control.dataset.filter || (control.hasAttribute('data-sort') ? 'sort' : ''); if (!key) return; if (control instanceof HTMLInputElement && control.type === 'checkbox') { setParamAndNavigate(key, control.checked); return; } setParamAndNavigate(key, control.value); }); });
    for (const chip of conditionChips) { chip.addEventListener('click', () => { const group = chip.closest('[data-condition-group]'); const wasActive = chip.classList.contains('active'); group?.querySelectorAll('.condition-chip').forEach((item) => item.classList.remove('active')); if (!wasActive) chip.classList.add('active'); }); }
    conditionSubmit?.addEventListener('click', () => { const next = new URLSearchParams(); for (const chip of conditionChips.filter((item) => item.classList.contains('active'))) { const key = chip.dataset.conditionKey; const value = chip.dataset.conditionValue || ''; if (key === 'status' && value === labels.onlineAvailable) next.set('applyOnline', 'true'); else if (key === 'status' && value === labels.deadlineSoon) next.set('status', labels.deadlineSoon); else if (key === 'status' && value === labels.permanentApply) next.set('status', labels.always); else if (key === 'status' && value === labels.recentUpdated) next.set('sort', 'updated'); else if (key === 'age') next.set('target', value); else if (key === 'lifeStage') next.set('purpose', value); else if (key && value) next.set(key, value); } window.location.href = supportUrl(next, true); });
    if (hasQueryState) renderSupportResultsFromIndex().catch((error) => console.warn(error));
  </script>
