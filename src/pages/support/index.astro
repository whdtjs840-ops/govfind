---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PolicyCard from "../../components/PolicyCard.astro";
import { CheckCircle2, Search, SlidersHorizontal } from "@lucide/astro";
import { categories, categoryGroups, lifeStages, policies, popularKeywords, regions, sources } from "../../data/policies";

const params = Astro.url.searchParams;
const selectedQ = params.get("q") ?? "";
const selectedCategory = params.get("category") ?? "";
const selectedRegion = params.get("region") ?? "";
const selectedSource = params.get("source") ?? "";
const selectedStatus = params.get("status") ?? "";

const counts = {
  all: policies.length,
  deadline: policies.filter((policy) => policy.status === "마감임박" || /^D-/.test(policy.dday)).length,
  gov24: policies.filter((policy) => policy.source === "정부24 공공서비스 API").length,
  welfare: policies.filter((policy) => policy.source.includes("복지로")).length,
  kstartup: policies.filter((policy) => policy.source === "K-Startup API").length,
  youth: policies.filter((policy) => `${policy.title} ${policy.tags.join(" ")}`.includes("청년")).length,
  smallBusiness: policies.filter((policy) => `${policy.title} ${policy.tags.join(" ")}`.includes("소상공인")).length
};

function supportHref(next: Record<string, string>) {
  const query = new URLSearchParams();
  for (const [key, value] of Object.entries(next)) {
    if (value) query.set(key, value);
  }
  const value = query.toString();
  return value ? `/support/?${value}` : "/support/";
}

const quickTabs = [
  { label: "전체", count: counts.all, href: supportHref({}), active: !selectedQ && !selectedCategory && !selectedSource && !selectedStatus },
  { label: "마감임박", count: counts.deadline, href: supportHref({ status: "마감임박" }), active: selectedStatus === "마감임박" },
  { label: "정부24", count: counts.gov24, href: supportHref({ source: "정부24 공공서비스 API" }), active: selectedSource === "정부24 공공서비스 API" },
  { label: "복지로", count: counts.welfare, href: supportHref({ source: "복지로 API" }), active: selectedSource === "복지로 API" },
  { label: "K-Startup", count: counts.kstartup, href: supportHref({ source: "K-Startup API" }), active: selectedSource === "K-Startup API" },
  { label: "청년", count: counts.youth, href: supportHref({ q: "청년" }), active: selectedQ === "청년" },
  { label: "소상공인", count: counts.smallBusiness, href: supportHref({ q: "소상공인" }), active: selectedQ === "소상공인" }
];

const topCategories = categoryGroups.slice(0, 7);
---

<BaseLayout
  title="정부지원금 검색 결과 - GovFind"
  description="정부지원금을 키워드, 카테고리, 지역, 모집 상태, 공식 출처별로 검색하고 지원 대상, 필요 서류, 신청처를 비교하세요."
>
  <section class="support-search-head">
    <div class="wrap">
      <p class="eyebrow">정부지원금 검색</p>
      <h1>지원금, 혜택, 창업공고를 한 번에 찾기</h1>
      <p class="lead">정부24·복지로·K-Startup 데이터를 공식 출처 기준으로 정리했습니다. 조건을 확인한 뒤 최종 신청은 공식 신청처에서 진행하세요.</p>

      <form class="support-search-form" action="/support/" method="get">
        <div class="support-search-main">
          <Search size={21} aria-hidden="true" />
          <input name="q" type="search" value={selectedQ} placeholder="근로장려금, 청년월세, 소상공인, 창업지원금" />
          <button class="button" type="submit">검색</button>
        </div>
        <div class="support-search-selects">
          <select class="input" name="category" aria-label="카테고리">
            <option value="">전체 카테고리</option>
            {categories.map((item) => <option value={item} selected={selectedCategory === item}>{item}</option>)}
          </select>
          <select class="input" name="region" aria-label="지역">
            <option value="">전체 지역</option>
            {regions.map((item) => <option value={item} selected={selectedRegion === item}>{item}</option>)}
          </select>
          <select class="input" name="source" aria-label="출처">
            <option value="">전체 출처</option>
            {sources.map((item) => <option value={item} selected={selectedSource === item}>{item}</option>)}
          </select>
        </div>
      </form>

      <nav class="support-tabs" aria-label="빠른 결과 필터">
        {quickTabs.map((tab) => (
          <a class={tab.active ? "active" : ""} href={tab.href}>
            <span>{tab.label}</span>
            <strong>{tab.count.toLocaleString("ko-KR")}</strong>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section tight support-summary-band">
    <div class="wrap support-summary-grid">
      <div><strong>{counts.gov24.toLocaleString("ko-KR")}</strong><span>정부24 혜택</span></div>
      <div><strong>{counts.welfare.toLocaleString("ko-KR")}</strong><span>복지로 정책</span></div>
      <div><strong>{counts.kstartup.toLocaleString("ko-KR")}</strong><span>창업공고</span></div>
      <div><strong>공식</strong><span>신청처 이동</span></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap results-layout support-results-layout">
      <aside class="support-sidebar" aria-label="검색 필터">
        <details class="filter-card card" open>
          <summary><SlidersHorizontal size={18} />상세 필터</summary>
          <label>생애주기
            <select class="input" data-filter="lifeStage">
              <option value="">전체</option>
              {lifeStages.map((item) => <option value={item}>{item}</option>)}
            </select>
          </label>
          <label>모집 상태
            <select class="input" data-filter="status">
              <option value="">전체</option>
              <option selected={selectedStatus === "모집중"}>모집중</option>
              <option selected={selectedStatus === "마감임박"}>마감임박</option>
              <option selected={selectedStatus === "상시"}>상시</option>
              <option selected={selectedStatus === "예정"}>예정</option>
            </select>
          </label>
          <label>출처
            <select class="input" data-filter="source">
              <option value="">전체</option>
              {sources.map((item) => <option value={item}>{item}</option>)}
            </select>
          </label>
          <label class="check-row">
            <input type="checkbox" data-filter="online" />
            온라인 신청 가능
          </label>
        </details>

        <div class="card support-category-card">
          <h2>분야별 보기</h2>
          <div class="quick-tags">
            {topCategories.map((category) => <a class="chip" href={`/category/${category.slug}/`}>{category.label}</a>)}
          </div>
        </div>

        <div class="card support-source-card">
          <h2><CheckCircle2 size={18} /> 확인 기준</h2>
          <p>GovFind는 조건을 정리해 보여주며, 자격 판정과 접수는 각 기관 공식 페이지에서 진행됩니다.</p>
        </div>
      </aside>

      <div class="support-result-main">
        <div class="result-head support-result-head">
          <div>
            <p class="eyebrow"><span id="result-count">{policies.length}</span>개 결과</p>
            <h2>조건, 기한, 신청처를 빠르게 비교하세요</h2>
            <p class="notice">카드를 열면 지원 대상, 선정 기준, 필요 서류, FAQ와 공식 신청 링크를 확인할 수 있습니다.</p>
          </div>
          <select class="input small" data-sort aria-label="정렬">
            <option value="recommended">추천순</option>
            <option value="deadline">마감임박순</option>
            <option value="popular">인기순</option>
            <option value="online">온라인 신청 우선</option>
          </select>
        </div>

        <div class="support-keyword-row" aria-label="인기 검색어">
          {popularKeywords.slice(0, 12).map((keyword) => <a class="chip" href={`/support/?q=${encodeURIComponent(keyword)}`}>{keyword}</a>)}
        </div>

        <div class="result-grid support-result-list">
          {policies.map((policy) => <PolicyCard policy={policy} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section tight dashboard-teaser">
    <div class="wrap split wide">
      <div>
        <p class="eyebrow">공식 신청 전 체크</p>
        <h2>민간 사이트에서 끝내지 말고 공식 원문까지 확인하세요</h2>
        <p class="lead">GovFind는 조건을 정리해 보여주는 정보 탐색 사이트입니다. 최종 자격 판정과 접수는 정부24, 복지로, 고용24, K-Startup 등 공식 기관에서 진행됩니다.</p>
        <div class="toolbar"><a class="button secondary" href="/sources/">공식 데이터 출처 보기</a></div>
      </div>
      <div class="notification-grid">
        <div><strong>대상 조건</strong><span>나이·소득·지역·가구 기준 확인</span></div>
        <div><strong>신청 기간</strong><span>마감일과 예산 소진 여부 확인</span></div>
        <div><strong>필요 서류</strong><span>계약서·증빙·신분 서류 확인</span></div>
        <div><strong>공식 원문</strong><span>최종 신청은 기관 페이지에서 진행</span></div>
      </div>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    const keyword = params.get("q")?.trim() ?? "";
    const selectedCategory = params.get("category")?.trim() ?? "";
    const selectedRegion = params.get("region")?.trim() ?? "";
    const selectedLife = params.get("lifeStage")?.trim() ?? "";
    const selectedStatus = params.get("status")?.trim() ?? "";
    const selectedSource = params.get("source")?.trim() ?? "";
    const selectedOnline = params.get("online") === "true";
    const selectedSort = params.get("sort")?.trim() ?? "recommended";
    const count = document.querySelector("#result-count");
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".support-card"));
    const lifeStage = document.querySelector<HTMLSelectElement>('[data-filter="lifeStage"]');
    const status = document.querySelector<HTMLSelectElement>('[data-filter="status"]');
    const source = document.querySelector<HTMLSelectElement>('[data-filter="source"]');
    const online = document.querySelector<HTMLInputElement>('[data-filter="online"]');
    const sort = document.querySelector<HTMLSelectElement>("[data-sort]");
    const resultGrid = document.querySelector<HTMLElement>(".result-grid");
    const topCategory = document.querySelector<HTMLSelectElement>('.support-search-selects select[name="category"]');
    const topRegion = document.querySelector<HTMLSelectElement>('.support-search-selects select[name="region"]');
    const topSource = document.querySelector<HTMLSelectElement>('.support-search-selects select[name="source"]');
    const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>(".support-tabs a"));

    if (lifeStage) lifeStage.value = selectedLife;
    if (status) status.value = selectedStatus;
    if (source) source.value = selectedSource;
    if (online) online.checked = selectedOnline;
    if (sort) sort.value = selectedSort;
    if (topCategory) topCategory.value = selectedCategory;
    if (topRegion) topRegion.value = selectedRegion;
    if (topSource) topSource.value = selectedSource;

    function querySignature(search: string) {
      const values = new URLSearchParams(search);
      const entries = Array.from(values.entries()).filter(([key]) => ["q", "category", "region", "source", "status"].includes(key));
      return entries.sort(([a], [b]) => a.localeCompare(b)).map(([key, value]) => `${key}=${value}`).join("&");
    }

    function syncActiveTabs() {
      const current = querySignature(window.location.search);
      for (const tab of tabs) {
        const tabUrl = new URL(tab.href);
        tab.classList.toggle("active", querySignature(tabUrl.search) === current);
      }
    }

    function ddayRank(value: string) {
      if (value === "D-Day") return 0;
      if (value.startsWith("D-")) return Number(value.replace("D-", "")) || 999;
      if (value === "상시") return 500;
      if (value === "예정") return 700;
      return 999;
    }

    function syncUrl() {
      const next = new URLSearchParams();
      if (keyword) next.set("q", keyword);
      if (selectedCategory) next.set("category", selectedCategory);
      if (selectedRegion) next.set("region", selectedRegion);
      if (lifeStage?.value) next.set("lifeStage", lifeStage.value);
      if (status?.value) next.set("status", status.value);
      if (source?.value) next.set("source", source.value);
      if (online?.checked) next.set("online", "true");
      if (sort?.value && sort.value !== "recommended") next.set("sort", sort.value);
      const query = next.toString();
      window.history.replaceState(null, "", query ? `/support/?${query}` : "/support/");
    }

    function sortCards() {
      if (!resultGrid || !sort) return;
      const sorted = [...cards].sort((a, b) => {
        if (sort.value === "deadline") return ddayRank(a.dataset.dday ?? "") - ddayRank(b.dataset.dday ?? "");
        if (sort.value === "popular") return Number(b.dataset.views ?? 0) - Number(a.dataset.views ?? 0);
        if (sort.value === "online") return Number(b.dataset.online === "true") - Number(a.dataset.online === "true");
        return Number(b.dataset.score ?? 0) - Number(a.dataset.score ?? 0);
      });
      for (const card of sorted) resultGrid.appendChild(card);
    }

    function applyFilters() {
      const lifeValue = lifeStage?.value ?? "";
      const statusValue = status?.value ?? "";
      const sourceValue = source?.value ?? "";
      const onlineOnly = online?.checked ?? false;
      let visible = 0;

      for (const card of cards) {
        const text = card.dataset.search ?? "";
        const cardCategory = card.dataset.category ?? "";
        const cardRegion = card.dataset.region ?? "";
        const cardStatus = card.dataset.status ?? "";
        const cardSource = card.dataset.source ?? "";
        const cardOnline = card.dataset.online === "true";
        const matchKeyword = !keyword || text.includes(keyword);
        const matchCategory = !selectedCategory || cardCategory === selectedCategory;
        const matchRegion = !selectedRegion || cardRegion === selectedRegion || cardRegion === "전국" || cardRegion === "지역별";
        const matchLife = !lifeValue || text.includes(lifeValue);
        const matchStatus = !statusValue || cardStatus === statusValue;
        const matchSource = !sourceValue || cardSource === sourceValue;
        const matchOnline = !onlineOnly || cardOnline;
        const isVisible = matchKeyword && matchCategory && matchRegion && matchLife && matchStatus && matchSource && matchOnline;
        card.style.display = isVisible ? "" : "none";
        if (isVisible) visible += 1;
      }

      if (count) count.textContent = String(visible);
      sortCards();
      syncUrl();
      syncActiveTabs();
    }

    lifeStage?.addEventListener("change", applyFilters);
    status?.addEventListener("change", applyFilters);
    source?.addEventListener("change", applyFilters);
    online?.addEventListener("change", applyFilters);
    sort?.addEventListener("change", applyFilters);
    applyFilters();
  </script>
</BaseLayout>
