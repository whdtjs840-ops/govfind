---
import BaseLayout from "../layouts/BaseLayout.astro";
import PolicyCard from "../components/PolicyCard.astro";
import { policies } from "../data/policies";
import { dedupePolicies } from "../utils/policyUtils";

const { canonical: displayPolicies } = dedupePolicies(policies);
const priorityTerms = [
  "근로장려금",
  "자녀장려금",
  "청년 월세",
  "국민취업지원제도",
  "소상공인 정책자금",
  "청년도약계좌",
  "주거급여",
  "문화누리카드"
];
const popular = priorityTerms
  .map((term) => displayPolicies.find((policy) => `${policy.title} ${policy.tags.join(" ")}`.includes(term.replace(/\s+/g, "")) || `${policy.title} ${policy.tags.join(" ")}`.includes(term)))
  .filter(Boolean);
---

<BaseLayout title="인기 정부지원금 - GovFind" description="많이 찾는 핵심 정부지원금과 공식 신청처를 빠르게 확인하세요." canonical="/popular/">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">인기</p>
      <h1>많이 찾는 핵심 정책을 먼저 확인하세요</h1>
      <p class="lead">검색 수요가 높은 대표 정책을 공식 출처 기준으로 정리했습니다. 최종 신청 가능 여부는 공식 기관에서 확인하세요.</p>
      <div class="quick-tags">
        {priorityTerms.map((term) => <a class="chip" href={`/support/?q=${encodeURIComponent(term)}`}>{term}</a>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid cols-2">
      {popular.map((policy) => policy && <PolicyCard policy={policy} />)}
    </div>
  </section>
</BaseLayout>
