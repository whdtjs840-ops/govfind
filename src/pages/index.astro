---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Search } from "@lucide/astro";
import { policies, categoryGroups } from "../data/policies";
import {
  cleanSummary,
  deadlineDisplay,
  getPolicyCounts,
  getPublicPolicies,
  urgentPolicies
} from "../utils/policyUtils";

const publicPolicies = getPublicPolicies(policies);
const counts = getPolicyCounts(policies);
const publicPolicyCountLabel = counts.all.toLocaleString("ko-KR");
const latestPrograms = [...publicPolicies]
  .sort((a, b) => b.updatedAt.localeCompare(a.updatedAt))
  .slice(0, 16);

const urgentSlugs = new Set<string>();
const deadlinePrograms = [
  ...urgentPolicies(publicPolicies),
  ...publicPolicies.filter((policy) => policy.status === "모집중")
].filter((policy) => {
  if (urgentSlugs.has(policy.slug)) return false;
  urgentSlugs.add(policy.slug);
  return true;
}).slice(0, 10).map((policy) => ({
  ...policy,
  displayDday: deadlineDisplay(policy)
}));

const categoryCount = (label: string) => counts.byCategory[label] ?? 0;
const categoryRoute = (label: string) => {
  const matched = categoryGroups.find((category) => category.label === label);
  if (matched) return `/category/${matched.slug}/`;
  return "/support/";
};
const categoryCards = [
  { label: "전체", count: counts.all, href: "/support/" },
  ...categoryGroups.map((category) => ({
    label: category.label,
    count: categoryCount(category.label),
    href: categoryRoute(category.label)
  }))
].filter((category) => category.count > 0).slice(0, 12);

const popularKeywords = ["청년", "지원", "채용", "정부", "복지", "창업", "사업", "지원금", "소상공인"];

function isGenericOfficialUrl(value: string) {
  try {
    const url = new URL(value);
    const genericHosts = new Set([
      "www.gov.kr",
      "www.bokjiro.go.kr",
      "www.k-startup.go.kr",
      "www.bizinfo.go.kr",
      "www.work24.go.kr",
      "www.hometax.go.kr",
      "www.nhis.or.kr"
    ]);
    return genericHosts.has(url.hostname) && ["", "/", "/web/index.do", "/index.do"].includes(url.pathname);
  } catch {
    return false;
  }
}

function compactSummary(value?: string) {
  const summary = cleanSummary(value ?? "");
  return summary.length > 130 ? `${summary.slice(0, 129)}…` : summary;
}
---

<BaseLayout
  title="GovFind - 정부지원금 맞춤 검색"
  description="청년, 소상공인, 주거, 복지, 고용 지원사업을 한 곳에서 검색하세요."
>
  <section class="govhelp-home-hero" aria-label="지원사업 검색">
    <div class="wrap govhelp-home-wrap">
      <p class="govhelp-kicker">공식 출처 기반 지원사업 포털</p>
      <h1>나에게 맞는 정부지원금 찾기</h1>
      <p class="govhelp-count-line"><strong data-public-count>{publicPolicyCountLabel}</strong>건의 지원사업 모집중</p>
      <form class="govhelp-search" action="/support/" method="get" aria-label="지원사업 검색">
        <Search size={24} aria-hidden="true" />
        <input name="q" type="search" placeholder="예: 청년 월세, 육아 수당, 소상공인 대출" autocomplete="off" />
        <button type="submit">검색</button>
      </form>
      <div class="govhelp-keywords" aria-label="인기 검색어">
        <strong>인기</strong>
        {popularKeywords.map((keyword) => (
          <a href={`/support/?q=${encodeURIComponent(keyword)}`}>{keyword}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="govhelp-category-section" aria-label="주요 카테고리">
    <div class="wrap govhelp-category-grid">
      {categoryCards.map((category) => (
        <a href={category.href} class="govhelp-category-card">
          <span>{category.label}</span>
          <strong>{category.count.toLocaleString("ko-KR")}</strong>
        </a>
      ))}
    </div>
  </section>

  <section class="govhelp-home-section" aria-label="마감 임박 지원사업">
    <div class="wrap">
      <div class="govhelp-section-head">
        <h2>마감 임박</h2>
        <a href="/deadline/">더보기 →</a>
      </div>
      <div class="govhelp-deadline-list">
        {deadlinePrograms.map((policy) => (
          <a class="govhelp-deadline-item" href={`/support/${policy.slug}/`}>
            <span class:list={["govhelp-dday", policy.displayDday === "D-Day" ? "is-day" : ""]}>{policy.displayDday}</span>
            <strong>{policy.title}</strong>
            <em>{policy.category}</em>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="govhelp-home-section govhelp-latest-section" aria-label="최신 지원사업">
    <div class="wrap">
      <div class="govhelp-section-head">
        <h2>최신 지원사업</h2>
        <a href="/support/">전체 보기 →</a>
      </div>
      <div class="govhelp-program-list">
        {latestPrograms.map((policy) => {
          const dday = deadlineDisplay(policy);
          const officialLinkIsGeneric = isGenericOfficialUrl(policy.officialUrl);
          return (
            <article class="govhelp-program-card">
              <div class="govhelp-program-badges">
                <span>모집중</span>
                <span>{policy.category}</span>
                <span>{dday}</span>
              </div>
              <h3><a href={`/support/${policy.slug}/`}>{policy.title}</a></h3>
              <p>{compactSummary(policy.summary)}</p>
              <div class="govhelp-program-meta">
                <span>{policy.agency}</span>
                <span>{policy.deadline}</span>
              </div>
              <div class="govhelp-program-actions">
                <a href={`/support/${policy.slug}/`}>상세 보기</a>
                <a
                  class="govhelp-apply"
                  href={policy.officialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-official-link-kind={officialLinkIsGeneric ? "generic" : "direct"}
                >
                  {officialLinkIsGeneric ? "공식 사이트 확인" : "신청처 바로가기"}
                </a>
              </div>
            </article>
          );
        })}
      </div>
      <div class="govhelp-all-link">
        <a class="button" href="/support/">전체 지원사업 보기</a>
      </div>
    </div>
  </section>

  <script>
    async function syncPublicCount() {
      try {
        const response = await fetch('/search-index.json', { cache: 'no-store' });
        if (!response.ok) return;
        const payload = await response.json();
        const count = Number(payload.count ?? payload.items?.length);
        if (!Number.isFinite(count)) return;
        const label = count.toLocaleString('ko-KR');
        document.querySelectorAll('[data-public-count]').forEach((node) => {
          node.textContent = label;
        });
      } catch (error) {
        console.warn('public count sync failed', error);
      }
    }
    syncPublicCount();
  </script>
</BaseLayout>
