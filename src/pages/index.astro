---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ArrowRight, CalendarClock, Search } from "@lucide/astro";
import { policies, categoryGroups } from "../data/policies";
import { guides } from "../data/guides";
import { dedupePolicies, isSearchOnlyPolicy, urgentPolicies } from "../utils/policyUtils";
import QuickConditionSearch from "../components/QuickConditionSearch.astro";

const { canonical: displayPolicies } = dedupePolicies(policies);
const publicPolicies = displayPolicies.filter((policy) => !isSearchOnlyPolicy(policy));
const publicGuides = guides.filter((guide) => guide.category !== "SEO");
const totalCountLabel = publicPolicies.length.toLocaleString("ko-KR");
const latestUpdateLabel = [...publicPolicies].sort((a, b) => b.updatedAt.localeCompare(a.updatedAt))[0]?.updatedAt ?? "공식 출처 확인 필요";
const urgent = urgentPolicies(publicPolicies);
const latest = [...publicPolicies].sort((a, b) => b.updatedAt.localeCompare(a.updatedAt)).slice(0, 18);
const featured = [...publicPolicies].sort((a, b) => b.views - a.views).slice(0, 6);
const recommendedGuides = publicGuides.slice(0, 4);
const categoryCounts = categoryGroups.map((category) => ({
  ...category,
  count: publicPolicies.filter(
    (policy) => policy.category === category.label || category.keywords.some((keyword) => `${policy.title} ${policy.tags.join(" ")}`.includes(keyword))
  ).length
}));
const mainCategories = categoryCounts.slice(0, 9);
const actionKeywords = [
  "근로장려금 신청방법",
  "근로장려금 대상조회",
  "청년월세 지원 대상",
  "국민취업지원제도 신청조건",
  "건강보험 환급금 조회",
  "소상공인 정책자금 신청서류"
];
const quickEntryCards = [
  { title: "지원금 정보", desc: "현금성 지원과 생활비 지원을 먼저 확인", href: "/support/?q=지원금" },
  { title: "환급금 정보", desc: "근로장려금, 건강보험 환급 등 조회형 정보", href: "/support/?q=환급금" },
  { title: "대출·정책자금", desc: "소상공인, 주거, 창업 자금 지원", href: "/support/?q=정책자금" },
  { title: "청년", desc: "월세, 취업, 자산형성 정책 모아보기", href: "/category/youth/" },
  { title: "주거·월세", desc: "월세, 전세자금, 주거급여 확인", href: "/category/housing/" },
  { title: "창업·소상공인", desc: "창업공고와 소상공인 자금 확인", href: "/support/?q=소상공인" }
];
---

<BaseLayout
  title="GovFind - 정부지원금 맞춤 검색"
  description="공식 출처 기준으로 정리된 정부지원금 검색 서비스입니다. 자격을 단정하지 않고 조건 확인과 공식 신청처 이동을 돕습니다."
>
  <section class="home-plain-hero hero-compact">
    <div class="wrap">
      <h1>놓치기 쉬운 <strong>정부지원금</strong>, 내 조건으로 빠르게 찾아보세요</h1>
      <p class="home-count-line">공식 확인된 핵심 정책 {totalCountLabel}개</p>
      <p class="home-freshness-line">마지막 데이터 확인 {latestUpdateLabel} · 비로그인 조건검색 · 최종 신청은 공식 기관에서 진행</p>
      <p class="hero-lead">공식 출처 기준으로 정리된 정부지원금 검색 서비스입니다. 자격을 단정하지 않고, 조건 확인과 공식 신청처 이동을 돕습니다.</p>

      <div class="hero-cta-row">
        <a class="button" href="#condition-search">내 조건으로 찾기</a>
        <a class="button secondary" href="/deadline/">마감임박 지원금 보기</a>
      </div>

      <form class="hero-search" action="/support/" method="get" aria-label="정부지원금 검색">
        <div class="search-input-group">
          <Search class="search-icon" size={21} aria-hidden="true" />
          <input name="q" type="search" placeholder="근로장려금, 청년월세, 환급금, 소상공인 정책자금 검색" autocomplete="off" />
          <button type="submit">검색</button>
        </div>
      </form>

      <div class="hero-trending" aria-label="인기 검색어">
        <span class="trending-label">인기</span>
        {actionKeywords.map((keyword) => <a class="trending-pill" href={`/support/?q=${encodeURIComponent(keyword)}`}>{keyword}</a>)}
      </div>
    </div>
  </section>

  <section class="section tight home-condition-section">
    <div class="wrap">
      <QuickConditionSearch standalone />
    </div>
  </section>

  <section class="home-entry-strip">
    <div class="wrap">
      <div class="home-trust-grid" aria-label="GovFind 이용 기준">
        <div><strong>공식 출처 기준</strong><span>정부24·복지로·K-Startup 등 기관 안내 기준</span></div>
        <div><strong>자격 단정 없음</strong><span>대상·지역·기간 조건을 먼저 확인</span></div>
        <div><strong>공식 신청처 이동</strong><span>최종 신청은 공식 기관 페이지에서 진행</span></div>
        <div><strong>비로그인 탐색</strong><span>회원가입 없이 검색·필터·상세 비교부터 시작</span></div>
      </div>
      <div class="quick-entry-grid" aria-label="빠른 진입">
        {quickEntryCards.map((item) => (
          <a href={item.href} class="quick-entry-card">
            <strong>{item.title}</strong>
            <span>{item.desc}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="category-strip">
    <div class="wrap">
      <div class="category-chips" aria-label="카테고리 바로가기">
        <a href="/support/" class="cat-chip cat-chip-all">
          <span>전체</span>
          <span class="cat-chip-count">{totalCountLabel}</span>
        </a>
        {mainCategories.map((category) => (
          <a href={`/category/${category.slug}/`} class="cat-chip">
            <span>{category.label}</span>
            <span class="cat-chip-count">{category.count.toLocaleString("ko-KR")}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tight home-featured-section">
    <div class="wrap">
      <div class="section-header">
        <h2 class="section-heading">주목 받는 지원금</h2>
        <a href="/support/?sort=popular" class="section-more">더보기 <ArrowRight size={16} /></a>
      </div>
      <div class="featured-policy-grid">
        {featured.map((policy) => (
          <a href={`/support/${policy.slug}/`} class="featured-policy-card" data-event="featured_policy_click" data-policy={policy.slug}>
            <span>{policy.category}</span>
            <strong>{policy.title}</strong>
            <small>{policy.agency} · {policy.dday}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="wrap">
      <div class="section-header">
        <h2 class="section-heading">곧 만료되는 지원금</h2>
        <a href="/deadline/" class="section-more">더보기 <ArrowRight size={16} /></a>
      </div>
      <div class="deadline-scroll">
        {urgent.slice(0, 9).map((policy) => (
          <a href={`/support/${policy.slug}/`} class="deadline-card" data-event="deadline_click" data-policy={policy.slug}>
            <span class="deadline-dday">{policy.dday}</span>
            <span class="deadline-title">{policy.title}</span>
            <span class="deadline-cat">{policy.category}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section home-latest-section">
    <div class="wrap">
      <div class="section-header">
        <h2 class="section-heading">최신 지원사업</h2>
        <a href="/support/" class="section-more">전체 보기 <ArrowRight size={16} /></a>
      </div>

      <div class="policy-grid">
        {latest.map((policy) => (
          <article class="policy-card-home">
            <div class="card-accent"></div>
            <div class="card-body">
              <div class="card-badges">
                <span class="badge warn">{policy.status}</span>
                <span class="badge">{policy.category}</span>
                <span class="badge soft">{policy.dday}</span>
              </div>
              <h3><a class="card-title" href={`/support/${policy.slug}/`}>{policy.title}</a></h3>
              <p class="card-summary">{policy.summary}</p>
              <div class="card-meta">
                <span>{policy.agency}</span>
                <span class="meta-divider">·</span>
                <span>{policy.deadline}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="section-cta">
        <a href="/support/" class="button secondary">전체 지원사업 보기</a>
      </div>
    </div>
  </section>

  <section class="section tight band">
    <div class="wrap">
      <div class="section-header">
        <h2 class="section-heading">신청 전 가이드</h2>
        <a class="section-more" href="/guide/">가이드 전체 보기 <ArrowRight size={16} /></a>
      </div>
      <div class="guide-card-grid">
        {recommendedGuides.map((guide) => (
          <article class="card">
            <span class="badge soft">{guide.category}</span>
            <h3><a href={`/guide/${guide.slug}/`}>{guide.title}</a></h3>
            <p>{guide.description}</p>
            <a class="text-link" href={`/guide/${guide.slug}/`}>자세히 보기 <ArrowRight size={16} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight home-source-note">
    <div class="wrap">
      <CalendarClock size={24} />
      <div>
        <p class="eyebrow">공식 신청처 확인</p>
        <h2>자격을 단정하지 않고, 조건 확인과 공식 신청처 이동을 돕습니다.</h2>
        <p class="lead">지원 대상과 신청 가능 여부는 정부24·복지로·K-Startup 등 공식 안내에서 최종 확인하세요.</p>
      </div>
      <a class="button secondary" href="/sources/">출처 확인</a>
    </div>
  </section>
</BaseLayout>
