---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Search } from "@lucide/astro";
import { policies, categoryGroups } from "../data/policies";
import { deadlineDisplay, getPolicyCounts, getPublicPolicies, urgentPolicies } from "../utils/policyUtils";

const publicPolicies = getPublicPolicies(policies);
const counts = getPolicyCounts(policies);
const latestPrograms = [...publicPolicies].sort((a, b) => b.updatedAt.localeCompare(a.updatedAt)).slice(0, 9);
const urgentSlugs = new Set<string>();
const urgentBase = [
  ...urgentPolicies(publicPolicies),
  ...publicPolicies.filter((policy) => policy.status === "모집중")
].filter((policy) => {
  if (urgentSlugs.has(policy.slug)) return false;
  urgentSlugs.add(policy.slug);
  return true;
}).slice(0, 6);
const deadlinePrograms = urgentBase.map((policy) => ({
  ...policy,
  displayDday: deadlineDisplay(policy)
}));

const categoryCount = (label: string) => counts.byCategory[label] ?? 0;

const categoryRoute = (label: string) => {
  const matched = categoryGroups.find((category) => category.label === label);
  if (matched) return `/category/${matched.slug}/`;
  if (label === "전체") return "/support/";
  return `/support/?q=${encodeURIComponent(label)}`;
};

const categoryIcons: Record<string, string> = {
  "청년": "👨‍🎓",
  "복지": "🤝",
  "주거": "🏠",
  "고용": "💼",
  "창업": "🚀",
  "교육": "📚",
  "보건의료": "🏥",
  "문화생활": "🎨",
  "농림어업": "🌾",
  "소상공인": "🏪"
};

const categoryCards = [
  { icon: "📋", label: "전체", count: counts.all },
  ...categoryGroups.map((category) => ({
    icon: categoryIcons[category.label] ?? "📌",
    label: category.label,
    count: categoryCount(category.label)
  }))
].filter((category) => category.count > 0);

const popularKeywords = ["청년", "창업", "주거", "채용", "복지", "소상공인", "교육", "의료"];
---

<BaseLayout
  title="GovFind - 정부지원금 맞춤 검색"
  description="청년, 소상공인, 주거, 복지, 고용 지원사업을 한 곳에서 검색하세요."
>
  <section class="home-portal-hero">
    <div class="wrap">
      <div class="home-portal-hero-inner">
        <h1>나에게 맞는 지원금을 찾아보세요</h1>
        <p>청년, 소상공인, 주거, 복지, 고용 지원사업을 한 곳에서 검색하세요.</p>
        <form class="home-portal-search" action="/support/" method="get" aria-label="지원사업 검색">
          <Search size={24} aria-hidden="true" />
          <input name="q" type="search" placeholder="지원금, 지역, 대상, 키워드로 검색" autocomplete="off" />
          <button type="submit">검색</button>
        </form>
        <div class="home-portal-stats" aria-label="서비스 요약">
          <span>공식 출처로 선별한 핵심 지원정책 {counts.all.toLocaleString("ko-KR")}개</span>
          <span>매일 업데이트</span>
          <span>맞춤형 카테고리 탐색</span>
        </div>
      </div>
    </div>
  </section>

  <section class="home-portal-section home-keyword-section">
    <div class="wrap">
      <p class="home-section-label">인기 검색어</p>
      <div class="home-keyword-chips" aria-label="인기 검색어">
        {popularKeywords.map((keyword) => (
          <a href={`/support/?q=${encodeURIComponent(keyword)}`}>{keyword}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-portal-section">
    <div class="wrap">
      <div class="home-portal-section-head">
        <h2>카테고리별 지원사업</h2>
      </div>
      <div class="home-category-grid">
        {categoryCards.map((category) => (
          <a class="home-category-card" href={categoryRoute(category.label)}>
            <span class="home-category-icon" aria-hidden="true">{category.icon}</span>
            <strong>{category.label}</strong>
            <small>{category.count.toLocaleString("ko-KR")}건</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-portal-section">
    <div class="wrap">
      <div class="home-portal-section-head">
        <h2>마감 임박</h2>
        <a href="/deadline/">전체 보기</a>
      </div>
      <div class="home-deadline-grid">
        {deadlinePrograms.map((policy) => (
          <a class="home-deadline-card" href={`/support/${policy.slug}/`}>
            <span class:list={["home-dday-badge", policy.displayDday === "D-Day" ? "is-danger" : "is-warning"]}>{policy.displayDday}</span>
            <strong>{policy.title}</strong>
            <span class="home-program-category">{policy.category}</span>
            <small>{policy.agency}</small>
            <time>{policy.deadline}</time>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-portal-section home-latest-portal-section">
    <div class="wrap">
      <div class="home-portal-section-head">
        <h2>최신 지원사업</h2>
        <a href="/support/">전체 목록</a>
      </div>
      <div class="home-program-grid">
        {latestPrograms.map((policy, index) => (
          <article class="home-program-card">
            <div class="home-card-badges">
              <span class="home-status-badge">모집중</span>
              <span class="home-program-category">{policy.category}</span>
              <span class:list={["home-dday-badge", deadlineDisplay(policy) === "D-Day" ? "is-danger" : "is-warning"]}>
                {deadlineDisplay(policy)}
              </span>
            </div>
            <h3><a href={`/support/${policy.slug}/`}>{policy.title}</a></h3>
            <p>{policy.summary}</p>
            <div class="home-program-meta">
              <span>{policy.agency}</span>
              <time>{policy.deadline}</time>
            </div>
            <a class="home-detail-link" href={`/support/${policy.slug}/`}>자세히 보기</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
