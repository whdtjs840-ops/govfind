---
import BaseLayout from "../layouts/BaseLayout.astro";
import PolicyCard from "../components/PolicyCard.astro";
import { CheckCircle2, FileText, Search, ShieldCheck, TrendingUp } from "@lucide/astro";
import { policies, categories, popularKeywords } from "../data/policies";
import { guides } from "../data/guides";
import heroImage from "../assets/hero-govfind.png";

const featured = policies.slice(0, 3);
const urgent = policies.filter((policy) => policy.status === "마감임박" || policy.status === "모집중").slice(0, 4);
const popular = [...policies].sort((a, b) => b.views - a.views).slice(0, 4);
const latest = [...policies].sort((a, b) => b.updatedAt.localeCompare(a.updatedAt)).slice(0, 4);
const latestGuides = guides.slice(0, 3);
const totalViews = policies.reduce((sum, policy) => sum + policy.views, 0);
---

<BaseLayout
  title="GovFind - 내 조건에 맞는 정부지원금 찾기"
  description="나이, 지역, 가구상황, 관심 분야를 기준으로 정부지원금을 빠르게 좁히고 공식 신청처로 이동하세요."
>
  <section class="hero" style={`--hero-image: url(${heroImage.src})`}>
    <div class="wrap hero-inner">
      <div>
        <p class="eyebrow">govfind.kr</p>
        <h1>내 조건에 맞는 정부지원금을 빠르게 찾으세요</h1>
        <p class="lead">청년, 소상공인, 주거, 복지, 창업 지원금을 조건별로 정리하고 공식 신청처로 연결하는 비로그인 정보 포털입니다.</p>
        <div class="intent-tabs" aria-label="탐색 유형">
          <a href="/support/?q=지원금" class="active">지원금 정보</a>
          <a href="/support/?q=환급금">환급금 정보</a>
          <a href="/support/?q=대출">대출 정보</a>
        </div>
        <form class="search-panel hero-checker" action="/support/" method="get" aria-label="빠른 자격 확인">
          <label class="eyebrow" for="q">빠른 자격 확인</label>
          <div class="checker-grid">
            <input class="input" id="q" name="q" type="search" placeholder="예: 청년 월세, 소상공인 자금" />
            <select class="input" name="lifeStage" aria-label="생애주기">
              <option value="">생애주기</option>
              <option>청년</option>
              <option>사업자</option>
              <option>임신·출산·육아</option>
              <option>취약계층</option>
            </select>
            <select class="input" name="region" aria-label="지역">
              <option value="">지역</option>
              <option>전국</option>
              <option>서울</option>
              <option>경기</option>
              <option>지역별</option>
            </select>
            <button class="button" type="submit"><Search size={18} />추천 결과 보기</button>
          </div>
          <div class="quick-tags" aria-label="추천 검색어">
            {popularKeywords.slice(0, 6).map((keyword) => <a class="chip" href={`/support/?q=${encodeURIComponent(keyword)}`}>{keyword}</a>)}
          </div>
        </form>
        <div class="source-strip" aria-label="데이터 출처">
          <span>공식 출처</span>
          <b>정부24</b>
          <b>복지로</b>
          <b>고용24</b>
          <b>K-Startup</b>
          <b>소상공인 정책자금</b>
        </div>
      </div>
      <aside class="trust-panel" aria-label="서비스 원칙">
        <div><ShieldCheck size={20} /><strong>공식 출처 우선</strong><span>정부24·복지로·K-Startup 등 원문 연결</span></div>
        <div><CheckCircle2 size={20} /><strong>적합 이유 표시</strong><span>왜 추천됐는지 결과 카드에서 바로 확인</span></div>
        <div><FileText size={20} /><strong>신청 전 체크</strong><span>대상·서류·마감·문의처를 한 화면에 정리</span></div>
      </aside>
    </div>
  </section>

  <section class="section tight benchmark-dashboard">
    <div class="wrap">
      <div class="metric-grid" aria-label="서비스 지표">
        <div><strong>{policies.length}</strong><span>MVP 정책</span></div>
        <div><strong>{categories.length}</strong><span>핵심 카테고리</span></div>
        <div><strong>{totalViews.toLocaleString("ko-KR")}</strong><span>관심도 샘플</span></div>
        <div><strong>공식</strong><span>신청처 handoff</span></div>
      </div>
      <div class="category-rail" aria-label="카테고리 바로가기">
        {categories.map((category) => (
          <a href={`/support/?category=${encodeURIComponent(category)}`}>
            <span>{category}</span>
            <strong>{policies.filter((policy) => policy.category === category).length}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section product-flow">
    <div class="wrap">
      <p class="eyebrow">비로그인 탐색 흐름</p>
      <h2>검색부터 공식 신청처 이동까지 불필요한 가입 없이 확인합니다</h2>
      <div class="flow-grid">
        <div><span>1</span><strong>빠른 자격 확인</strong><p>나이·지역·가구상황을 가볍게 입력</p></div>
        <div><span>2</span><strong>정렬된 추천 결과</strong><p>마감, 온라인 신청, 적합 이유로 비교</p></div>
        <div><span>3</span><strong>상세 체크리스트</strong><p>지원대상·서류·FAQ를 구조화</p></div>
        <div><span>4</span><strong>공식 신청처 이동</strong><p>최종 판단과 신청은 공식 기관에서 진행</p></div>
      </div>
    </div>
  </section>

  <section class="section tight band">
    <div class="wrap">
      <p class="eyebrow">정책 카탈로그</p>
      <h2>마감임박과 최신 정책을 바로 확인하세요</h2>
      <div class="two-lists">
        <section class="list-panel">
          <h3>마감 임박</h3>
          {urgent.map((policy) => (
            <a href={`/support/${policy.slug}/`}>
              <span>{policy.dday}</span>
              <strong>{policy.title}</strong>
              <small>{policy.agency} · {policy.source}</small>
            </a>
          ))}
        </section>
        <section class="list-panel">
          <h3>최근 업데이트</h3>
          {latest.map((policy) => (
            <a href={`/support/${policy.slug}/`}>
              <span>{policy.updatedAt}</span>
              <strong>{policy.title}</strong>
              <small>{policy.category} · {policy.region}</small>
            </a>
          ))}
        </section>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">관심도 높은 정책</p>
      <h2>현재 주목 받는 지원금</h2>
      <div class="ranking-grid">
        {popular.map((policy, index) => (
          <a class="ranking-card" href={`/support/${policy.slug}/`}>
            <span class="rank">{index + 1}</span>
            <div>
              <strong>{policy.title}</strong>
              <small><TrendingUp size={14} /> {policy.views.toLocaleString("ko-KR")} 관심 · {policy.dday}</small>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split wide">
      <div>
        <p class="eyebrow">검색·필터 구조</p>
        <h2>카테고리, 상태, 출처, 지역으로 좁히는 탐색 경험</h2>
        <p class="lead">출처, 모집 상태, 생애주기, 지역, 온라인 신청 가능 여부를 기준으로 공식 정보를 빠르게 좁혀봅니다.</p>
        <div class="toolbar">
          {categories.map((category) => <a class="chip" href={`/support/?category=${encodeURIComponent(category)}`}>{category}</a>)}
        </div>
      </div>
      <div class="mini-board">
        {urgent.map((policy) => (
          <a href={`/support/${policy.slug}/`}>
            <span>{policy.dday}</span>
            <strong>{policy.title}</strong>
            <small>{policy.agency}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight band">
    <div class="wrap split wide">
      <div>
        <p class="eyebrow">고의도 검색 진입</p>
        <h2>몰라서 놓치는 지원금, 짧은 링크로 바로 진입</h2>
        <p class="lead">광고·검색 유입 사용자가 긴 설명 없이 바로 눌러볼 수 있도록 키워드형 진입점을 분리했습니다.</p>
      </div>
      <div class="landing-link-grid">
        <a href="/support/?q=근로장려금"><strong>근로장려금</strong><span>신청방법 · 조건확인 · 지급일</span></a>
        <a href="/support/?q=환급금"><strong>환급금 받기</strong><span>건강보험 · 국민연금 · 통신비</span></a>
        <a href="/support/?q=청년월세"><strong>청년월세</strong><span>대상조회 · 필요서류 · 공식 신청</span></a>
        <a href="/support/?q=소상공인"><strong>소상공인 자금</strong><span>운영자금 · 창업 · 예산 소진</span></a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap split wide">
      <div>
        <p class="eyebrow">가이드 허브</p>
        <h2>신청 전에 확인해야 할 조건과 서류</h2>
      </div>
      <div class="grid">
        {latestGuides.map((guide) => (
          <article class="card">
            <span class="badge">{guide.category}</span>
            <h3><a href={`/guide/${guide.slug}/`}>{guide.title}</a></h3>
            <p>{guide.description}</p>
            <a class="text-link" href={`/guide/${guide.slug}/`}><FileText size={16} />가이드 보기</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
