---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Database, ExternalLink, ShieldCheck } from "@lucide/astro";
import { infrastructureIntegrations, normalizedPolicyFields, publicApiSources } from "../data/integrations";
---

<BaseLayout title="공식 데이터 출처와 연동 설계 - GovFind" description="GovFind가 정부지원금 정보를 공공 API 중심으로 정규화하고 공식 신청처로 연결하는 방식입니다." canonical="/sources/">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">데이터 출처</p>
      <h1>데이터는 공공, 신청은 공식 기관으로 연결합니다</h1>
      <p class="lead">GovFind는 민간 사이트가 자격을 단정하지 않고, 공공 데이터와 공식 원문을 정리해 사용자가 신청 전 확인할 수 있게 돕는 구조를 기본으로 합니다.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid">
      <section class="card">
        <h2><Database size={20} />핵심 공공데이터 연동</h2>
        <div class="source-table-wrap">
          <table class="source-table">
            <thead>
              <tr>
                <th>연동</th>
                <th>제공자</th>
                <th>목적</th>
                <th>핵심 필드</th>
                <th>연결 기준</th>
              </tr>
            </thead>
            <tbody>
              {publicApiSources.map((source) => (
                <tr>
                  <td>{source.name}</td>
                  <td>{source.provider}</td>
                  <td>{source.purpose}</td>
                  <td>{source.fields}</td>
                  <td>{source.endpoint}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="card">
        <h2><ShieldCheck size={20} />내부 표준 스키마</h2>
        <p class="notice">원천 API의 필드명을 그대로 노출하지 않고, 아래 축으로 정규화해 검색·필터·상세·대시보드에서 공통 사용합니다.</p>
        <div class="schema-grid">
          {normalizedPolicyFields.map((field) => (
            <div>
              <strong>{field.label}</strong>
              <code>{field.key}</code>
              <span>{field.description}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="card">
        <h2><ExternalLink size={20} />제품 인프라 연동</h2>
        <div class="integration-grid">
          {infrastructureIntegrations.map((item) => (
            <div>
              <strong>{item.name}</strong>
              <span>{item.role}</span>
              <small>{item.provider}</small>
            </div>
          ))}
        </div>
        <p class="notice">계정, 알림, OCR, 분석은 확장 인프라이며 최종 신청과 자격 판정은 항상 공식 기관에서 확인하도록 설계합니다.</p>
      </section>
    </div>
  </section>
</BaseLayout>
