---
import BaseLayout from "../layouts/BaseLayout.astro";
import PolicyCard from "../components/PolicyCard.astro";
import { policies } from "../data/policies";
import { dedupePolicies, upcomingPolicies, urgentPolicies } from "../utils/policyUtils";

const { canonical: displayPolicies } = dedupePolicies(policies);
const urgent = urgentPolicies(displayPolicies);
const upcoming = upcomingPolicies(displayPolicies).slice(0, 9);
---

<BaseLayout title="마감임박 정부지원금 - GovFind" description="접수 중이거나 마감이 가까운 정부지원금을 먼저 확인하세요.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">마감임박</p>
      <h1>놓치기 쉬운 지원금을 먼저 확인하세요</h1>
      <p class="lead">D-Day부터 D-14까지, 날짜가 명확한 정책만 먼저 보여줍니다. 신청 기간과 예산 소진 여부는 공식 공고에서 최종 확인해야 합니다.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap grid cols-3">
      {urgent.map((policy) => <PolicyCard policy={policy} />)}
    </div>
  </section>
  {urgent.length < 6 && upcoming.length > 0 && (
    <section class="section tight band">
      <div class="wrap">
        <div class="section-header">
          <div>
            <p class="eyebrow">곧 확인할 정책</p>
            <h2 class="section-heading">마감일이 다가오는 다음 정책</h2>
          </div>
        </div>
        <div class="deadline-scroll">
          {upcoming.map((policy) => (
            <a href={`/support/${policy.slug}/`} class="deadline-card">
              <span class="deadline-dday">{policy.dday}</span>
              <span class="deadline-title">{policy.title}</span>
              <span class="deadline-cat">{policy.category}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
