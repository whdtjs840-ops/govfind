---
import BaseLayout from "../layouts/BaseLayout.astro";
import { policies } from "../data/policies";
---

<BaseLayout title="정부지원금 비교 - GovFind" description="지원금별 기관, 지역, 지원 규모, 신청 상태, 공식 신청처를 한눈에 비교하세요.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">비교</p>
      <h1>지원금 조건과 신청 상태를 한눈에 비교하세요</h1>
      <p class="lead">최종 자격과 신청 가능 여부는 공식 기관에서 확인해야 하지만, 비교에 필요한 핵심 정보는 먼저 정리해 볼 수 있습니다.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap compare-table-wrap">
      <table class="compare-table">
        <thead>
          <tr>
            <th>정책명</th>
            <th>기관</th>
            <th>지역</th>
            <th>지원 규모</th>
            <th>상태</th>
            <th>공식 신청</th>
          </tr>
        </thead>
        <tbody>
          {policies.map((policy) => (
            <tr>
              <td><a class="text-link" href={`/support/${policy.slug}/`}>{policy.title}</a></td>
              <td>{policy.agency}</td>
              <td>{policy.region}</td>
              <td>{policy.amount}</td>
              <td><span class={policy.status === "마감임박" ? "badge deadline" : "badge warn"}>{policy.status}</span></td>
              <td><a class="button secondary" href={policy.officialUrl} target="_blank" rel="noopener noreferrer">이동</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
