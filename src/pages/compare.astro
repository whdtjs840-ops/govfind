---
import BaseLayout from "../layouts/BaseLayout.astro";
import { policies } from "../data/policies";
---

<BaseLayout title="정부지원금 비교 - GovFind" description="지원금별 대상, 기관, 지역, 신청 상태를 한눈에 비교하세요.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">비교</p>
      <h1>지원대상과 신청 상태를 한눈에 비교하세요</h1>
      <p class="lead">정확한 신청 가능 여부는 각 공식 기관에서 최종 확인해야 합니다.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap grid">
      {policies.map((policy) => (
        <article class="card">
          <div class="meta">
            <span class="badge">{policy.category}</span>
            <span class={policy.status === "모집중" ? "badge deadline" : "badge warn"}>{policy.status}</span>
          </div>
          <h2><a href={`/support/${policy.slug}/`}>{policy.title}</a></h2>
          <p>{policy.summary}</p>
          <ul class="list-clean">
            <li>기관: {policy.agency}</li>
            <li>지역: {policy.region}</li>
            <li>지원 규모: {policy.amount}</li>
            <li>신청 상태: {policy.deadline}</li>
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
