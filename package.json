{
  "name": "govfind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @govfind/web",
    "dev:api": "npm run dev --workspace @govfind/api",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "db:generate": "npm run db:generate --workspace @govfind/db",
    "db:migrate": "npm run db:migrate --workspace @govfind/db",
    "db:seed": "npm run db:seed --workspace @govfind/db",
    "validate:policies": "tsx scripts/validate-policies.mjs",
    "import:gov24:dry-run": "tsx scripts/import-gov24-dry-run.mjs",
    "import:bokjiro-central:dry-run": "tsx scripts/import-bokjiro-central-dry-run.mjs",
    "discover:bokjiro-central": "tsx scripts/discover-bokjiro-central.mjs",
    "promote:bokjiro-central:dry-run": "tsx scripts/promote-bokjiro-central-dry-run.mjs",
    "promote:bokjiro-central:generate": "tsx scripts/promote-bokjiro-central-generate.mjs",
    "promote:bokjiro-central:apply:dry-run": "tsx scripts/promote-bokjiro-central-apply-dry-run.mjs",
    "promote:bokjiro-central:apply": "tsx scripts/promote-bokjiro-central-apply.mjs",
    "discover:gov24": "tsx scripts/discover-gov24.mjs",
    "normalize:staging:gov24": "tsx scripts/normalize-gov24-staging.mjs",
    "validate:staging:gov24": "tsx scripts/validate-gov24-staging.mjs",
    "promote:gov24:dry-run": "tsx scripts/promote-gov24-dry-run.mjs",
    "promote:gov24:generate": "tsx scripts/promote-gov24-generate.mjs",
    "promote:gov24:apply:dry-run": "tsx scripts/promote-gov24-apply-dry-run.mjs",
    "promote:gov24:apply": "tsx scripts/promote-gov24-apply.mjs",
    "legacy:prebuild": "node scripts/sync-welfare-api.mjs && node scripts/sync-local-welfare-api.mjs && node scripts/sync-public-service-api.mjs && node scripts/sync-kstartup-api.mjs && node scripts/sync-youth-api.mjs",
    "legacy:dev": "astro dev --host 127.0.0.1",
    "legacy:build": "astro build",
    "legacy:preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@lucide/astro": "^1.16.0",
    "astro": "^6.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
